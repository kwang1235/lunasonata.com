---
// src/components/BaseHead.astro
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, DEFAULT_OG_IMAGE, AUTHOR_NAME } from '../consts';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
  article?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  noindex = false,
  article = false,
} = Astro.props;

// 이미지 절대 경로 URL 변환
let imageURL: URL;
if (typeof image === 'string') {
  if (image.startsWith('http://') || image.startsWith('https://')) {
    imageURL = new URL(image);
  } else {
    imageURL = new URL(image, Astro.site || SITE_URL);
  }
} else {
  imageURL = new URL(image.src, Astro.site || SITE_URL);
}
---

<!-- DNS 사전 조회만 유지 (preconnect는 외부 서버 핸드셰이크 지연을 유발하므로 제거) -->
<link rel="dns-prefetch" href="https://image.lunasonata.com" />

<!-- 기본 메타데이터 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" type="image/png" href="/sekwang_favicon.png" />
<link rel="shortcut icon" type="image/png" href="/sekwang_favicon.png" />
<link rel="apple-touch-icon" href="/sekwang_favicon.png" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site || SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />

<!-- 정규 URL 및 로봇 색인 제어 -->
<link rel="canonical" href={canonicalURL} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />

<!-- Open Graph (소셜 공유) -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- 💡 공개 페이지 전용: 애널리틱스, 구글 애드센스(단일 호출), 구조화 데이터 스키마 -->
{!noindex && (
  <>
    <!-- Matomo Analytics & 애드센스 지연 로드 스크립트 -->
    <script is:inline>
      let isDeferredScriptsLoaded = false;
      function loadDeferredScripts() {
        if (isDeferredScriptsLoaded) return;
        isDeferredScriptsLoaded = true;

        // 1. Matomo 통계 로드
        var _paq = window._paq = window._paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        var u = "https://analytics.kwang1235.synology.me/";
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '1']);
        var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
        g.async = true; g.src = u + 'matomo.js';
        s.parentNode.insertBefore(g, s);

        // 2. 구글 애드센스 지연 로드
        var adScript = document.createElement('script');
        adScript.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4839414905225875";
        adScript.async = true;
        adScript.crossOrigin = "anonymous";
        document.head.appendChild(adScript);

        // 이벤트 제거
        ['scroll', 'mousemove', 'touchstart', 'click'].forEach(evt =>
          window.removeEventListener(evt, loadDeferredScripts)
        );
      }

      // 첫 상호작용(스크롤/터치/클릭/마우스이동) 시 실행 or 3.5초 뒤 자동 로드
      ['scroll', 'mousemove', 'touchstart', 'click'].forEach(evt =>
        window.addEventListener(evt, loadDeferredScripts, { passive: true, once: true })
      );
    </script>

    <!-- 1. 사이트 기본 스키마 (WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_TITLE,
      "url": SITE_URL
    })} />

    <!-- 2. 블로그 포스트 전용 스키마 (개별 글일 때만 실행) -->
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "image": imageURL.toString(),
        "author": {
          "@type": "Person",
          "name": AUTHOR_NAME,
          "url": SITE_URL
        },
        "publisher": {
          "@type": "Organization",
          "name": SITE_TITLE,
          "url": SITE_URL
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalURL.toString()
        }
      })} />
    )}
  </>
)}