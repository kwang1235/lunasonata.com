---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_URL, DEFAULT_OG_IMAGE } from '../consts';
import { Font } from 'astro:assets';

// 💡 noindex 속성을 받을 수 있도록 타입 정의 추가
interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

// 💡 noindex 변수를 가져오고 기본값을 false로 설정
const { title, description, image = DEFAULT_OG_IMAGE, noindex = false } = Astro.props;

// 이미지 경로 가공 (절대 경로 URL 및 상대 경로 대응)
let imageURL: URL;

if (typeof image === 'string') {
  if (image.startsWith('http://') || image.startsWith('https://')) {
    imageURL = new URL(image);
  } else {
    imageURL = new URL(image, Astro.site || SITE_URL);
  }
} else {
  imageURL = new URL(image.src, Astro.site || SITE_URL);
}
---

<meta http-equiv="Cache-Control" content="max-age=31536000, public" />
<link rel="dns-prefetch" href="https://image.lunasonata.com" />
<link rel="preconnect" href="https://image.lunasonata.com" crossorigin />

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" type="image/png" href="/sekwang_favicon.png" />
<link rel="shortcut icon" type="image/png" href="/sekwang_favicon.png" />
<link rel="apple-touch-icon" href="/sekwang_favicon.png" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site || SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<style is:inline>
  @font-face {
    font-display: swap;
  }
</style>

<link rel="canonical" href={canonicalURL} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<link rel="preload" as="image" href={imageURL} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="세광" />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{!noindex && (
  <>
    <script is:inline>
      var _paq = window._paq = window._paq || [];
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u="https://analytics.kwang1235.synology.me/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '1']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_TITLE,
      "url": SITE_URL
    })} />

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4839414905225875"
      crossorigin="anonymous"
    ></script>
  </>
)}

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_TITLE,
  "url": SITE_URL
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": imageURL.toString(),
  "author": {
    "@type": "Person",
    "name": "세광",
    "url": SITE_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "url": SITE_URL
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
})} />

<script
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4839414905225875"
  crossorigin="anonymous"
></script>