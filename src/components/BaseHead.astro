---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_URL, DEFAULT_OG_IMAGE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

const { title, description, image = DEFAULT_OG_IMAGE } = Astro.props;

// 이미지 경로 가공 (Astro ImageMetadata 또는 문자열 경로 대응)
const imageURL = typeof image === 'string'
  ? new URL(image, Astro.site || SITE_URL)
  : new URL(image.src, Astro.site || SITE_URL);
---

<!-- 브라우저 캐싱 힌트 및 리소스 도메인 사전 연결 -->
<meta http-equiv="Cache-Control" content="max-age=31536000, public" />
<link rel="dns-prefetch" href="https://image.lunasonata.com" />
<link rel="preconnect" href="https://image.lunasonata.com" crossorigin />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- 1. 파비콘(Favicon) 연동 (sekwang_favicon.png 지정) -->
<link rel="icon" type="image/png" href="/sekwang_favicon.png" />
<link rel="apple-touch-icon" href="/sekwang_favicon.png" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site || SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<!-- 폰트 로딩 동안 기본 텍스트를 먼저 보여주어 렌더링 차단 방지 -->
<style is:inline>
  @font-face {
    font-display: swap;
  }
</style>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="세광" />

<!-- 검색엔진 수집 및 색인 허용 -->
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook / KakaoTalk -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="세광로그" />
<meta property="og:locale" content="ko_KR" />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Matomo Tracking Code -->
<script is:inline>
  var _paq = window._paq = window._paq || [];
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (function() {
    var u="https://analytics.kwang1235.synology.me/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '1']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
  })();
</script>

<!-- 구글 & 네이버 상단 노출을 위한 Article 구조화 데이터 (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": imageURL.toString(),
  "author": {
    "@type": "Person",
    "name": "세광",
    "url": SITE_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "url": SITE_URL
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
})} />