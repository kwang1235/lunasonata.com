</header>

<!-- 모바일 바텀시트 오버레이 & 드로어 (Header 밖으로 분리) -->
<div class="bottom-sheet-backdrop" id="sheetBackdrop"></div>
<div class="bottom-sheet-drawer" id="mobileNav">
  <div class="sheet-handle-wrapper">
    <div class="sheet-handle"></div>
  </div>
  <div class="sheet-content">
    <a href="/blog/" class="mobile-link">전체글</a>
    
    <div class="mobile-category-group">
      <span class="mobile-category-title">카테고리</span>
      <div class="mobile-category-chips">
        {allCategories.length > 0 ? (
          allCategories.map((category) => (
            <a href={`/category/${category}/`} class="category-chip">
              #{category}
            </a>
          ))
        ) : (
          <span class="no-category">카테고리 없음</span>
