---
// src/components/Header.astro
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

// 1. Content Collection에서 비공개(draft) 글 제외하고 가져오기
const posts = (
  await getCollection('blog', ({ data }) => {
    return data.draft !== true && String(data.draft).toLowerCase() !== 'true';
  })
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 2. 카테고리 목록 추출
const allCategories = [
  ...new Set(
    posts.flatMap((post) => {
      if (Array.isArray(post.data.categories)) return post.data.categories;
      if (typeof (post.data as any).category === 'string') return [(post.data as any).category];
      return [];
    }).filter(Boolean)
  ),
].sort((a, b) => a.localeCompare(b, 'ko'));

// 3. 스포트라이트 검색용 데이터 구조화
const searchData = posts.map((post) => {
  const cats = Array.isArray(post.data.categories)
    ? post.data.categories
    : typeof (post.data as any).category === 'string'
    ? [(post.data as any).category]
    : [];
  return {
    id: post.data.slug || post.id,
    title: post.data.title,
    description: post.data.description || '',
    category: cats.join(', '),
    pubDate: post.data.pubDate.toISOString().split('T')[0]
  };
});

// 타이틀의 한 글자씩 분리하여 배열로 생성
const titleLetters = SITE_TITLE.split('');
---

<header class="site-header">
  <div class="header-container">
    <!-- 💡 한 글자씩 파도타며 반짝이는 인터랙티브 텍스트 로고 -->
    <a href="/" class="blog-logo" aria-label={`${SITE_TITLE} 홈으로 이동`}>
      <span class="logo-animated-text">
        {titleLetters.map((char, index) => (
          <span 
            class="char-item" 
            style={`--char-index: ${index};`}
          >
            {char === ' ' ? '\u00A0' : char}
          </span>
        ))}
      </span>
      <span class="logo-sparkle"></span>
    </a>

    <!-- PC 네비게이션 -->
    <nav class="desktop-nav">
      <div class="nav-item dropdown">
        <button class="dropdown-btn" aria-haspopup="true">
          블로그 <span class="arrow">▾</span>
        </button>
        <div class="dropdown-menu">
          <a href="/blog/">전체글</a>
          <div class="category-subheader">카테고리</div>
          {allCategories.length > 0 ? (
            allCategories.map((category) => (
              <a href={`/category/${category}/`} class="category-item">
                - {category}
              </a>
            ))
          ) : (
            <span class="no-category">카테고리 없음</span>
          )}
        </div>
      </div>
      <a href="/about/" class="nav-item">소개</a>

      <!-- PC 검색 버튼 (모달 트리거) -->
      <button type="button" class="nav-item search-icon-btn search-trigger-btn" aria-label="검색">
        <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </nav>

    <!-- 모바일 헤더 우측 컨트롤 (검색 + 햄버거) -->
    <div class="mobile-header-actions">
      <button type="button" class="mobile-search-btn search-trigger-btn" aria-label="검색">
        <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      
      <button class="mobile-menu-btn" id="menuToggle" aria-label="메뉴 열기">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- 모바일 바텀시트 오버레이 & 드로어 -->
<div class="bottom-sheet-backdrop" id="sheetBackdrop"></div>
<div class="bottom-sheet-drawer" id="mobileNav">
  <div class="sheet-handle-wrapper">
    <div class="sheet-handle"></div>
  </div>
  <div class="sheet-content">
    <a href="/blog/" class="mobile-link">전체글</a>
    
    <div class="mobile-category-group">
      <span class="mobile-category-title">카테고리</span>
      <div class="mobile-category-chips">
        {allCategories.length > 0 ? (
          allCategories.map((category) => (
            <a href={`/category/${category}/`} class="category-chip">
              #{category}
            </a>
          ))
        ) : (
          <span class="no-category">카테고리 없음</span>
        )}
      </div>
    </div>

    <a href="/about/" class="mobile-link">소개</a>
  </div>
</div>

<!-- 스포트라이트 검색 모달 -->
<div id="spotlightBackdrop" class="spotlight-backdrop">
  <div class="spotlight-box">
    <div class="spotlight-input-wrapper">
      <svg class="spotlight-input-icon" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="spotlightInput" class="spotlight-input" placeholder="글 제목 또는 내용으로 검색..." autocomplete="off" />
      <button id="spotlightClose" class="spotlight-close-btn">ESC</button>
    </div>
    <ul id="spotlightResults" class="spotlight-results">
      <div class="spotlight-empty">검색어를 입력하면 목록이 표시됩니다.</div>
    </ul>
    <div class="spotlight-footer">
      <span class="spotlight-footer-key"><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
      <span class="spotlight-footer-key"><kbd>↵</kbd> 선택</span>
      <span class="spotlight-footer-key"><kbd>ESC</kbd> 닫기</span>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg-primary, #fcfbf9);
    border-bottom: 1px solid var(--border-color, #ebeae6);
    backdrop-filter: blur(12px);
  }

  .header-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* ✨ 큼직하고 시선을 끄는 로고 컨테이너 */
  .blog-logo {
    font-family: 'Gowun Batang', 'Montserrat', serif;
    font-size: 1.65rem;
    font-weight: 800;
    text-decoration: none !important;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    position: relative;
    cursor: pointer;
    user-select: none;
  }

  .logo-animated-text {
    display: inline-flex;
    align-items: center;
  }

  /* 💡 글자 한 글자씩 물결치고 색상이 변화하는 키프레임 애니메이션 */
  .char-item {
    display: inline-block;
    color: #1e293b;
    animation: letterWave 3.6s ease-in-out infinite;
    animation-delay: calc(var(--char-index) * 0.16s);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  @keyframes letterWave {
    0%, 100% {
      transform: translateY(0) scale(1);
      color: #1e293b;
      text-shadow: none;
    }
    15% {
      transform: translateY(-4px) scale(1.08);
      color: #5c6255; /* 세광로그 올리브 포인트 컬러 */
      text-shadow: 0 4px 12px rgba(92, 98, 85, 0.35);
    }
    30% {
      transform: translateY(0) scale(1);
      color: #1e293b;
      text-shadow: none;
    }
  }

  /* 마우스 호버 시 글자들이 튕기듯 회전/도약 */
  .blog-logo:hover .char-item {
    animation: letterBounce 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    animation-delay: calc(var(--char-index) * 0.06s);
    color: #5c6255;
  }

  @keyframes letterBounce {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-6px) scale(1.15) rotate(-3deg); }
    100% { transform: translateY(0) scale(1) rotate(0deg); }
  }

  /* 로고 옆 펄스 포인트 */
  .logo-sparkle {
    width: 6.5px;
    height: 6.5px;
    background-color: var(--accent-color, #5c6255);
    border-radius: 50%;
    display: inline-block;
    animation: sparkleBreathe 2.4s ease-in-out infinite alternate;
  }

  @keyframes sparkleBreathe {
    0% {
      transform: scale(0.8);
      opacity: 0.4;
      box-shadow: 0 0 0 0 rgba(92, 98, 85, 0.4);
    }
    100% {
      transform: scale(1.35);
      opacity: 1;
      box-shadow: 0 0 10px 3px rgba(92, 98, 85, 0.35);
    }
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    color: var(--text-secondary, #5d6268);
    text-decoration: none !important;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .nav-item:hover {
    color: var(--accent-color, #5c6255);
    background-color: rgba(92, 98, 85, 0.06);
  }

  .nav-item.search-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .search-svg {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px !important;
    display: inline-block;
    flex-shrink: 0;
  }

  /* 드롭다운 메뉴 (PC) */
  .dropdown {
    position: relative;
  }

  .dropdown-btn {
    background: none;
    border: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary, #5d6268);
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .dropdown:hover .dropdown-btn {
    color: var(--accent-color, #5c6255);
    background-color: rgba(92, 98, 85, 0.06);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    max-height: 240px;
    overflow-y: auto;
    background-color: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #ebeae6);
    box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 0.5rem 0;
    display: none;
    flex-direction: column;
    z-index: 100;
  }

  .dropdown-menu::-webkit-scrollbar {
    width: 4px;
  }
  .dropdown-menu::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 4px;
  }

  .dropdown:hover .dropdown-menu {
    display: flex;
  }

  .dropdown-menu a {
    padding: 0.55rem 1rem;
    color: var(--text-secondary, #5d6268);
    text-decoration: none !important;
    font-size: 0.9rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .dropdown-menu a:hover {
    color: var(--accent-color, #5c6255);
    background-color: #f8fafc;
  }

  .category-subheader {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted, #9aa0a6);
    padding: 0.5rem 1rem 0.2rem;
    text-transform: uppercase;
  }

  .category-item {
    padding-left: 1.5rem !important;
  }

  .no-category {
    font-size: 0.85rem;
    color: var(--text-muted, #9aa0a6);
    padding: 0.5rem 1rem;
  }

  /* 모바일 상단 액션 */
  .mobile-header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-search-btn {
    background: transparent;
    border: none;
    padding: 0.4rem;
    color: var(--text-primary, #22252a);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  .bar {
    height: 2px;
    width: 100%;
    background-color: var(--text-primary, #22252a);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
    background-color: var(--accent-color, #5c6255);
  }
  .mobile-menu-btn.active .bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
    background-color: var(--accent-color, #5c6255);
  }

  /* 바텀시트 모바일 드로어 */
  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1001;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bottom-sheet-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-sheet-drawer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1002;
    background-color: var(--bg-card, #ffffff);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.12);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }

  .bottom-sheet-drawer.open {
    transform: translateY(0);
  }

  .sheet-handle-wrapper {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0 0.25rem;
  }

  .sheet-handle {
    width: 36px;
    height: 4px;
    background-color: #cbd5e1;
    border-radius: 2px;
  }

  .sheet-content {
    padding: 1rem 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }

  .mobile-link {
    color: var(--text-primary, #22252a);
    text-decoration: none !important;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .mobile-category-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mobile-category-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted, #9aa0a6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mobile-category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-height: 180px;
    overflow-y: auto;
    padding: 0.25rem 0;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-category-chips::-webkit-scrollbar {
    width: 4px;
  }
  .mobile-category-chips::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 4px;
  }

  .category-chip {
    white-space: nowrap;
    padding: 0.45rem 0.9rem;
    background-color: #f1f5f9;
    color: #475569;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }

  .category-chip:active {
    background-color: var(--accent-color, #5c6255);
    color: #ffffff;
  }

  /* 스포트라이트 검색 모달 */
  .spotlight-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .spotlight-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .spotlight-box {
    width: 100%;
    max-width: 620px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 1px solid #e2e8f0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    transform: scale(0.96);
    transition: transform 0.2s ease;
  }

  .spotlight-backdrop.open .spotlight-box {
    transform: scale(1);
  }

  .spotlight-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .spotlight-input-icon {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    stroke: #64748b;
    fill: none;
  }

  .spotlight-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.1rem;
    font-weight: 500;
    color: #0f172a;
    background: transparent;
  }

  .spotlight-input::placeholder {
    color: #94a3b8;
  }

  .spotlight-close-btn {
    background: #f1f5f9;
    border: none;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .spotlight-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    list-style: none !important;
    margin: 0 !important;
  }

  :global(.spotlight-item) {
    margin-bottom: 0.25rem !important;
    list-style: none !important;
  }

  :global(.spotlight-item a) {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.35rem !important;
    padding: 0.85rem 1rem !important;
    border-radius: 12px !important;
    background-color: transparent !important;
    transition: background-color 0.15s ease !important;
    text-decoration: none !important;
    color: inherit !important;
  }

  :global(.spotlight-item a:hover),
  :global(.spotlight-item.active a) {
    background-color: #f1f5f9 !important;
  }

  :global(.spotlight-item-header) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.75rem !important;
    width: 100% !important;
  }

  :global(.spotlight-item-title) {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    line-height: 1.4 !important;
    margin: 0 !important;
  }

  :global(.spotlight-item-meta) {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    flex-shrink: 0 !important;
  }

  :global(.spotlight-item-category) {
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    color: var(--accent-color, #5c6255) !important;
    background-color: rgba(92, 98, 85, 0.1) !important;
    padding: 0.15rem 0.5rem !important;
    border-radius: 6px !important;
  }

  :global(.spotlight-item-date) {
    font-size: 0.75rem !important;
    color: #64748b;
  }

  :global(.spotlight-item-desc) {
    font-size: 0.875rem !important;
    color: #64748b;
    margin: 0 !important;
    line-height: 1.45 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  :global(.spotlight-empty) {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .spotlight-footer {
    padding: 0.6rem 1.25rem;
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    font-size: 0.75rem;
    color: #64748b;
  }

  .spotlight-footer-key {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .spotlight-footer-key kbd {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-size: 0.7rem;
    color: #475569;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
  }

  /* 반응형 분기점 (768px 이하 모바일) */
  @media (max-width: 768px) {
    .blog-logo {
      font-size: 1.45rem;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-header-actions {
      display: flex;
    }
    .spotlight-backdrop {
      padding-top: 5vh;
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .spotlight-footer {
      display: none;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  const sheetBackdrop = document.getElementById('sheetBackdrop');

  function openSheet() {
    menuToggle?.classList.add('active');
    mobileNav?.classList.add('open');
    sheetBackdrop?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeSheet() {
    menuToggle?.classList.remove('active');
    mobileNav?.classList.remove('open');
    sheetBackdrop?.classList.remove('open');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileNav?.classList.contains('open')) {
      closeSheet();
    } else {
      openSheet();
    }
  });

  sheetBackdrop?.addEventListener('click', closeSheet);
</script>

<script is:inline define:vars={{ searchData }}>
  const triggerBtns = document.querySelectorAll('.search-trigger-btn');
  const backdrop = document.getElementById('spotlightBackdrop');
  const input = document.getElementById('spotlightInput');
  const resultsContainer = document.getElementById('spotlightResults');
  const closeBtn = document.getElementById('spotlightClose');

  let activeIndex = -1;

  function openSpotlight() {
    if (!backdrop || !input) return;
    backdrop.classList.add('open');
    input.value = '';
    renderResults('');
    setTimeout(() => input.focus(), 50);
  }

  function closeSpotlight() {
    if (!backdrop) return;
    backdrop.classList.remove('open');
  }

  triggerBtns.forEach((btn) => {
    btn.addEventListener('click', openSpotlight);
  });

  closeBtn?.addEventListener('click', closeSpotlight);

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeSpotlight();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (backdrop?.classList.contains('open')) {
        closeSpotlight();
      } else {
        openSpotlight();
      }
    }

    if (!backdrop?.classList.contains('open')) return;

    const items = resultsContainer.querySelectorAll('.spotlight-item');

    if (e.key === 'Escape') {
      closeSpotlight();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveItem(items);
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      }
    } else if (e.key === 'Enter') {
      if (activeIndex >= 0 && items[activeIndex]) {
        e.preventDefault();
        const link = items[activeIndex].querySelector('a');
        if (link) link.click();
      }
    }
  });

  function updateActiveItem(items) {
    items.forEach((item, idx) => {
      if (idx === activeIndex) {
        item.classList.add('active');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('active');
      }
    });
  }

  input?.addEventListener('input', (e) => {
    const query = e.target.value.trim().toLowerCase();
    renderResults(query);
  });

  function renderResults(query) {
    activeIndex = -1;
    if (!resultsContainer) return;

    if (!query) {
      resultsContainer.innerHTML = '<div class="spotlight-empty">검색어를 입력하면 목록이 표시됩니다.</div>';
      return;
    }

    const filtered = searchData.filter((post) => 
      post.title.toLowerCase().includes(query) || 
      post.description.toLowerCase().includes(query) ||
      post.category.toLowerCase().includes(query)
    );

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `<div class="spotlight-empty">"${escapeHtml(query)}"에 대한 검색 결과가 없습니다.</div>`;
      return;
    }

    resultsContainer.innerHTML = filtered.map((post) => `
      <li class="spotlight-item">
        <a href="/${post.id}/">
          <div class="spotlight-item-header">
            <span class="spotlight-item-title">${escapeHtml(post.title)}</span>
            <div class="spotlight-item-meta">
              ${post.category ? `<span class="spotlight-item-category">${escapeHtml(post.category)}</span>` : ''}
              <span class="spotlight-item-date">${escapeHtml(post.pubDate)}</span>
            </div>
          </div>
          ${post.description ? `<p class="spotlight-item-desc">${escapeHtml(post.description)}</p>` : ''}
        </a>
      </li>
    `).join('');
  }

  function escapeHtml(str) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
</script>