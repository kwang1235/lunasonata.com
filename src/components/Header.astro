---
import { getCollection } from 'astro:content';

// 1. Astro Content Collection에서 글 데이터 가져오기
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 카테고리 목록 추출
const allCategories = [
  ...new Set(posts.map((post) => post.data.category).filter(Boolean))
];

// 검색용 데이터 구조화
const searchData = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description || '',
  category: post.data.category || '',
  pubDate: post.data.pubDate.toISOString().split('T')[0]
}));
---

<header class="site-header">
  <div class="header-container">
    <!-- 블로그 이름 (클릭 시 홈으로 이동) -->
    <a href="/" class="blog-logo">
      세광's 블로그
    </a>

    <!-- PC 네비게이션 -->
    <nav class="desktop-nav">
      <div class="nav-item dropdown">
        <button class="dropdown-btn">블로그 <span class="arrow">▾</span></button>
        <div class="dropdown-menu">
          <a href="/blog">전체글</a>
          <div class="category-subheader">카테고리</div>
          {allCategories.length > 0 ? (
            allCategories.map((category) => (
              <a href={`/category/${category}`} class="category-item">
                - {category}
              </a>
            ))
          ) : (
            <span class="no-category">카테고리 없음</span>
          )}
        </div>
      </div>
      <a href="/about" class="nav-item">소개</a>

      <!-- PC 검색 아이콘 버튼 (모달 트리거) -->
      <button type="button" class="nav-item search-icon-btn search-trigger-btn" aria-label="검색">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </nav>

    <!-- 모바일 햄버거 버튼 -->
    <button class="mobile-menu-btn" id="menuToggle" aria-label="메뉴 열기">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- 모바일 메뉴바 -->
  <nav class="mobile-nav" id="mobileNav">
    <a href="/blog" class="mobile-link">전체글</a>
    
    <div class="mobile-category-group">
      <span class="mobile-category-title">카테고리</span>
      <div class="mobile-category-list">
        {allCategories.length > 0 ? (
          allCategories.map((category) => (
            <a href={`/category/${category}`} class="mobile-category-item">
              - {category}
            </a>
          ))
        ) : (
          <span class="no-category">카테고리 없음</span>
        )}
      </div>
    </div>

    <div class="mobile-search-row">
      <a href="/about" class="mobile-link">소개</a>
      <!-- 모바일 검색 아이콘 버튼 (모달 트리거) -->
      <button type="button" class="nav-item search-icon-btn search-trigger-btn" aria-label="검색">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- 스포트라이트 검색 모달 -->
<div id="spotlightBackdrop" class="spotlight-backdrop">
  <div class="spotlight-box">
    <div class="spotlight-input-wrapper">
      <svg style="width: 20px !important; height: 20px !important; min-width: 20px !important; stroke: #64748b; fill: none;" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="spotlightInput" class="spotlight-input" placeholder="글 제목 또는 내용으로 검색..." autocomplete="off" />
      <button id="spotlightClose" class="spotlight-close-btn">ESC</button>
    </div>
    <ul id="spotlightResults" class="spotlight-results">
      <div class="spotlight-empty">검색어를 입력하면 목록이 표시됩니다.</div>
    </ul>
    <div class="spotlight-footer">
      <span class="spotlight-footer-key"><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
      <span class="spotlight-footer-key"><kbd>↵</kbd> 선택</span>
      <span class="spotlight-footer-key"><kbd>ESC</kbd> 닫기</span>
    </div>
  </div>
</div>

<script>
  // 모바일 햄버거 토글 스크립트
  const menuToggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');

  menuToggle?.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    mobileNav?.classList.toggle('open');
  });
</script>

<!-- 스포트라이트 검색 동작 스크립트 -->
<script is:inline define:vars={{ searchData }}>
  const triggerBtns = document.querySelectorAll('.search-trigger-btn');
  const backdrop = document.getElementById('spotlightBackdrop');
  const input = document.getElementById('spotlightInput');
  const resultsContainer = document.getElementById('spotlightResults');
  const closeBtn = document.getElementById('spotlightClose');

  let activeIndex = -1;

  function openSpotlight() {
    if (!backdrop || !input) return;
    backdrop.classList.add('open');
    input.value = '';
    renderResults('');
    setTimeout(() => input.focus(), 50);
  }

  function closeSpotlight() {
    if (!backdrop) return;
    backdrop.classList.remove('open');
  }

  triggerBtns.forEach((btn) => {
    btn.addEventListener('click', openSpotlight);
  });

  closeBtn?.addEventListener('click', closeSpotlight);

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeSpotlight();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (backdrop?.classList.contains('open')) {
        closeSpotlight();
      } else {
        openSpotlight();
      }
    }

    if (!backdrop?.classList.contains('open')) return;

    const items = resultsContainer.querySelectorAll('.spotlight-item');

    if (e.key === 'Escape') {
      closeSpotlight();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveItem(items);
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (items.length > 0) {
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      }
    } else if (e.key === 'Enter') {
      if (activeIndex >= 0 && items[activeIndex]) {
        e.preventDefault();
        const link = items[activeIndex].querySelector('a');
        if (link) link.click();
      }
    }
  });

  function updateActiveItem(items) {
    items.forEach((item, idx) => {
      if (idx === activeIndex) {
        item.classList.add('active');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('active');
      }
    });
  }

  input?.addEventListener('input', (e) => {
    const query = e.target.value.trim().toLowerCase();
    renderResults(query);
  });

  function renderResults(query) {
    activeIndex = -1;
    if (!resultsContainer) return;

    if (!query) {
      resultsContainer.innerHTML = '<div class="spotlight-empty">검색어를 입력하면 목록이 표시됩니다.</div>';
      return;
    }

    const filtered = searchData.filter((post) => 
      post.title.toLowerCase().includes(query) || 
      post.description.toLowerCase().includes(query) ||
      post.category.toLowerCase().includes(query)
    );

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `<div class="spotlight-empty">"${escapeHtml(query)}"에 대한 검색 결과가 없습니다.</div>`;
      return;
    }

    resultsContainer.innerHTML = filtered.map((post) => `
      <li class="spotlight-item">
        <a href="/${post.id}/">
          <div class="spotlight-item-header">
            <span class="spotlight-item-title">${escapeHtml(post.title)}</span>
            <div class="spotlight-item-meta">
              ${post.category ? `<span class="spotlight-item-category">${escapeHtml(post.category)}</span>` : ''}
              <span class="spotlight-item-date">${escapeHtml(post.pubDate)}</span>
            </div>
          </div>
          ${post.description ? `<p class="spotlight-item-desc">${escapeHtml(post.description)}</p>` : ''}
        </a>
      </li>
    `).join('');
  }

  function escapeHtml(str) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }
</script>

<style>
  /* ==========================================
     Header 기본 스타일 및 사용자 변수 적용
     ========================================== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg-primary, #fcfbf9);
    border-bottom: 1px solid var(--border-color, #ebeae6);
    backdrop-filter: blur(8px);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blog-logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary, #22252a);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .blog-logo:hover {
    color: var(--accent-color, #5c6255);
    transform: translateY(-1px);
  }

  /* PC 네비게이션 */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-item {
    color: var(--text-secondary, #5d6268);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .nav-item.search-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  /* 드롭다운 메뉴 (PC) */
  .dropdown {
    position: relative;
  }

  .dropdown-btn {
    background: none;
    border: none;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary, #5d6268);
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .dropdown-btn:hover {
    color: var(--accent-color, #5c6255);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    background-color: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #ebeae6);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 0.5rem 0;
    display: none;
    flex-direction: column;
  }

  .dropdown:hover .dropdown-menu {
    display: flex;
  }

  .dropdown-menu a {
    padding: 0.5rem 1rem;
    color: var(--text-secondary, #5d6268);
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .dropdown-menu a:hover {
    color: var(--accent-color, #5c6255);
  }

  .category-subheader {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted, #9aa0a6);
    padding: 0.5rem 1rem 0.2rem;
    text-transform: uppercase;
  }

  .category-item {
    padding-left: 1.5rem !important;
    font-size: 0.9rem !important;
  }

  .no-category {
    font-size: 0.85rem;
    color: var(--text-muted, #9aa0a6);
    padding: 0.5rem 1rem;
  }

  /* 모바일 네비게이션 & 햄버거 버튼 */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .bar {
    height: 2px;
    width: 100%;
    background-color: var(--text-primary, #22252a);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    background-color: var(--accent-color, #5c6255);
  }
  .mobile-menu-btn.active .bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    background-color: var(--accent-color, #5c6255);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background-color: var(--bg-primary, #fcfbf9);
    border-bottom: 1px solid var(--border-color, #ebeae6);
    padding: 1rem 1.5rem;
    gap: 1rem;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-link {
    color: var(--text-primary, #22252a);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .mobile-category-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-category-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted, #9aa0a6);
  }

  .mobile-category-list {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
    gap: 0.5rem;
  }

  .mobile-category-item {
    color: var(--text-secondary, #5d6268);
    text-decoration: none;
  }

  .mobile-search-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  /* ==========================================
     스포트라이트 검색 모달 스타일
     ========================================== */
  .spotlight-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .spotlight-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
  .spotlight-box {
    width: 100%;
    max-width: 620px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 1px solid #e2e8f0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    transform: scale(0.96);
    transition: transform 0.2s ease;
  }
  .spotlight-backdrop.open .spotlight-box {
    transform: scale(1);
  }
  .spotlight-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .spotlight-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.15rem;
    font-weight: 500;
    color: #0f172a;
    background: transparent;
  }
  .spotlight-input::placeholder {
    color: #94a3b8;
  }
  .spotlight-close-btn {
    background: #f1f5f9;
    border: none;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .spotlight-results {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    list-style: none !important;
    margin: 0 !important;
  }

  :global(.spotlight-item) {
    margin-bottom: 0.25rem !important;
    list-style: none !important;
  }

  :global(.spotlight-item a),
  :global(.spotlight-item a:visited),
  :global(.spotlight-item a:hover),
  :global(.spotlight-item a:active) {
    text-decoration: none !important;
    color: inherit !important;
    border-bottom: none !important;
  }

  :global(.spotlight-item a) {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.35rem !important;
    padding: 0.85rem 1rem !important;
    border-radius: 12px !important;
    background-color: transparent !important;
    transition: background-color 0.15s ease !important;
    border: none !important;
    box-shadow: none !important;
  }

  :global(.spotlight-item a:hover),
  :global(.spotlight-item.active a) {
    background-color: #f1f5f9 !important;
  }

  :global(.spotlight-item-header) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.75rem !important;
    width: 100% !important;
  }

  :global(.spotlight-item-title) {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    line-height: 1.4 !important;
    margin: 0 !important;
    text-decoration: none !important;
  }

  :global(.spotlight-item-meta) {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    flex-shrink: 0 !important;
  }

  :global(.spotlight-item-category) {
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    color: #2563eb !important;
    background-color: #eff6ff !important;
    padding: 0.15rem 0.5rem !important;
    border-radius: 6px !important;
  }

  :global(.spotlight-item-date) {
    font-size: 0.75rem !important;
    color: #64748b !important;
    text-decoration: none !important;
  }

  :global(.spotlight-item-desc) {
    font-size: 0.875rem !important;
    color: #64748b !important;
    margin: 0 !important;
    line-height: 1.45 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    text-decoration: none !important;
  }

  :global(.spotlight-empty) {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .spotlight-footer {
    padding: 0.6rem 1.25rem;
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    font-size: 0.75rem;
    color: #64748b;
  }
  .spotlight-footer-key {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .spotlight-footer-key kbd {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-size: 0.7rem;
    color: #475569;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
  }

  /* 반응형 분기점 (768px 이하 모바일) */
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .spotlight-backdrop {
      padding-top: 5vh;
    }
    .spotlight-footer {
      display: none;
    }
  }
</style>