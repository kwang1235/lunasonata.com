    display: flex !important;
    flex-direction: column !important;
    gap: 0.35rem !important;
    padding: 0.85rem 1rem !important;
    border-radius: 12px !important;
    background-color: transparent !important;
    transition: background-color 0.15s ease !important;
    border: none !important;
    box-shadow: none !important;
  }

  :global(.spotlight-item a:hover),
  :global(.spotlight-item.active a) {
    background-color: #f1f5f9 !important;
  }

  :global(.spotlight-item-header) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.75rem !important;
    width: 100% !important;
  }

  :global(.spotlight-item-title) {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    line-height: 1.4 !important;
    margin: 0 !important;
    text-decoration: none !important;
  }

  :global(.spotlight-item-meta) {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    flex-shrink: 0 !important;
  }

  :global(.spotlight-item-category) {
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    color: #2563eb !important;
    background-color: #eff6ff !important;
    padding: 0.15rem 0.5rem !important;
    border-radius: 6px !important;
  }

  :global(.spotlight-item-date) {
    font-size: 0.75rem !important;
    color: #64748b !important;
    text-decoration: none !important;
  }

  :global(.spotlight-item-desc) {
    font-size: 0.875rem !important;
    color: #64748b !important;
