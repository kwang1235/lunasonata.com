---
// src/components/Footer.astro
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<p class="copyright">
			&copy; {today.getFullYear()} <strong>루나소나타 블로그</strong>. All rights reserved.
		</p>
		
	</div>
</footer>

<style>
	/* 푸터 전체 컨테이너 */
	.site-footer {
		padding: 1rem;
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
		color: #64748b;
		font-size: 0.9rem;
		margin-top: auto;
	}

	/* 푸터 내부 레이아웃 */
	.footer-container {
		max-width: 1080px;
		margin: 0 auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: center;
	}

	.copyright {
		margin: 0;
		color: #334155;
	}

	.copyright strong {
		color: #0f172a;
		font-family: var(--font-heading, sans-serif);
	}

	.footer-sub {
		margin: 0;
		font-size: 0.8rem;
		color: #94a3b8;
	}
</style>