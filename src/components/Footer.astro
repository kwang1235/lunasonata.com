---
// src/components/Footer.astro
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- 사이트 브랜드 & 소개 -->
      <div class="footer-brand">
        <h3 class="footer-logo">{SITE_TITLE}</h3>
        <p class="footer-desc">{SITE_DESCRIPTION}</p>
      </div>

      <!-- 빠른 링크 -->
      <div class="footer-links">
        <h4 class="footer-heading">바로가기</h4>
        <ul>
          <li><a href="/">홈</a></li>
          <li><a href="/blog">블로그</a></li>
          <li><a href="/about">소개</a></li>
        </ul>
      </div>

      <!-- 소셜 미디어 링크 -->
      <div class="footer-social">
        <h4 class="footer-heading">소통하기</h4>
        <div class="social-icons">
          {SOCIAL_LINKS.instagram && (
            <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label="인스타그램">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
          )}
          {SOCIAL_LINKS.email && (
            <a href={`mailto:${SOCIAL_LINKS.email}`} aria-label="이메일 보낼 보내기">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {today.getFullYear()} Sekwang. All rights reserved.
      </p>
      <button id="back-to-top" class="back-to-top" aria-label="맨 위로 이동">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // 상단 이동 버튼 동작
  const backToTopBtn = document.getElementById('back-to-top');
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  .site-footer {
    background-color: var(--footer-bg, #f8f9fa);
    border-top: 1px solid var(--border-color, #ebeae6);
    padding: 3.5rem 1.5rem 2rem;
    margin-top: 1rem;
    color: var(--text-color, #334155);
    font-size: 0.95rem;
  }

  .footer-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .footer-logo {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.6rem 0;
    color: var(--heading-color, #1e293b);
    letter-spacing: -0.02em;
  }

  .footer-desc {
    margin: 0;
    line-height: 1.6;
    color: var(--text-muted, #475569); /* 명도 높여 가독성 확보 */
    font-size: 0.9rem;
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
    color: var(--heading-color, #1e293b);
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.35rem;
  }

  .footer-links a {
    display: inline-block;
    padding: 0.2rem 0; /* 모바일 터치 영역 확장 */
    color: var(--text-muted, #475569);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent-color, #5c6255);
  }

  .social-icons {
    display: flex;
    gap: 0.75rem;
  }

  .social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--icon-bg, #e2e8f0);
    color: var(--text-color, #334155);
    transition: all 0.2s ease;
  }

  .social-icons a:hover {
    background-color: var(--accent-color, #5c6255);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-color, #e2e8f0);
  }

  .copyright {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted, #64748b);
  }

  .back-to-top {
    background: var(--icon-bg, #e2e8f0);
    border: none;
    border-radius: 8px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-color, #334155);
    transition: all 0.2s ease;
  }

  .back-to-top:hover {
    background: var(--accent-color, #5c6255);
    color: #ffffff;
  }
</style>