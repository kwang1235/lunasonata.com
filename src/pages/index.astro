---
// src/pages/index.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,webp}');

// 💡 draft(비공개 글) 완벽 제외 필터링 적용 (/blog 목록과 100% 일치)
const posts = (await getCollection('blog', ({ data }) => {
  return data.draft !== true && String(data.draft).toLowerCase() !== 'true';
})).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);

// 공통 이미지 URL 변환 함수 (외부 NAS URL 최우선 처리)
async function getOptimizedBgUrl(heroImage: any, targetWidth = 600) {
  let bgUrl = '/blog-placeholder-1.jpg';
  if (!heroImage) return bgUrl;

  // 1. 이미 https:// 로 시작하는 외부/NAS 이미지 URL인 경우 즉시 반환
  if (typeof heroImage === 'string' && heroImage.startsWith('http')) {
    return heroImage;
  }

  // 2. Astro 내장 assets 이미지 처리
  if (typeof heroImage === 'object' && heroImage !== null) {
    const optimized = await getImage({ src: heroImage, width: targetWidth, format: 'webp' });
    return optimized.src;
  } else if (typeof heroImage === 'string') {
    const fileName = heroImage.split('/').pop();
    const imagePath = `/src/assets/${fileName}`;

    if (images[imagePath]) {
      const imageModule = await images[imagePath]();
      const optimized = await getImage({ src: imageModule.default, width: targetWidth, format: 'webp' });
      return optimized.src;
    }
    return heroImage;
  }
  return bgUrl;
}

// 1. Featured Post 배경 처리 (안전하게 전달)
const featuredBgUrl = featuredPost 
  ? await getOptimizedBgUrl(featuredPost.data.heroImage) 
  : '/blog-placeholder-1.jpg';

// 2. Recent Posts 배경 처리
const processedRecentPosts = await Promise.all(
  recentPosts.map(async (post) => ({
    ...post,
    bgUrl: await getOptimizedBgUrl(post.data.heroImage),
  }))
);
---

<!doctype html>
<html lang="ko" class="index-html">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- LCP 모바일 속도 최적화: 메인 LATEST 카드 배경 이미지를 1순위로 즉시 로드 -->
  <link rel="preload" as="image" href={featuredBgUrl} />
  </head>
  <body class="index-body">
    <Header />
    
    <main class="home-snap-container">
      <!-- Section 1: Hero & Main Journal Intro (fade-in 추가) -->
      <section class="snap-section hero-section fade-in">
        <div class="section-inner">
          <span class="sub-label">LUNA SONATA JOURNAL</span>
          <h1 class="hero-title">기록은 삶을 선명하게 만든다</h1>
          <p class="hero-description">
            생각의 깊이, 일상의 온기, 그리고 발걸음이 머문 풍경.<br/>
            세광의 프라이빗 저널에 오신 것을 환영합니다.
          </p>
          {featuredPost && (
            <div class="featured-wrapper fade-in delay-1">
              <a href={`/${featuredPost.data.slug || featuredPost.id}/`} class="main-featured-card">
                <div class="featured-bg" style={`background-image: url('${featuredBgUrl}');`}></div>
                <div class="featured-overlay"></div>
                <div class="featured-content">
                  <div class="featured-header">
                    <span class="badge">LATEST</span>
                    <time><FormattedDate date={featuredPost.data.pubDate} /></time>
                  </div>
                  <span class="featured-title">{featuredPost.data.title}</span>
                  <span class="featured-arrow">→</span>
                </div>
              </a>
            </div>
          )}
        </div>
      </section>

      <!-- Section 2: Recent Posts Summary (fade-in 및 순차 delay 추가) -->
      <section class="snap-section archive-section fade-in delay-2">
        <div class="section-inner">
          <h2 class="section-heading">최근의 기록들</h2>
          <div class="recent-grid">
            {processedRecentPosts.map((post, index) => (
              <article class={`recent-card-blur fade-in delay-${index + 1}`}>
                <a href={`/${post.data.slug || post.id}/`}>
                  {/* 흐릿한 배경 이미지 레이어 */}
                  <div 
                    class="card-bg" 
                    style={`background-image: url('${post.bgUrl}');`}
                  ></div>
                  {/* 가독성을 위한 어두운 오버레이 */}
                  <div class="card-overlay"></div>
                  
                  {/* 실제 콘텐츠 레이어 */}
                  <div class="card-content">
                    <time><FormattedDate date={post.data.pubDate} /></time>
                    <h3>{post.data.title}</h3>
                    {post.data.description && (
                      <p class="card-desc">{post.data.description}</p>
                    )}
                    <span class="read-more">Read More →</span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* 데스크톱 및 기본 반응형 레이아웃 */
  .home-snap-container {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .snap-section {
    padding: 3rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-inner {
    max-width: var(--content-width, 1000px);
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  .sub-label {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--text-muted, #888);
    display: block;
    margin-bottom: 1rem;
  }

  .hero-title {
    margin-bottom: 1.5rem;
    font-size: 2.2rem;
    font-weight: 700;
  }

  .hero-description {
    color: var(--text-secondary, #555);
    font-family: var(--font-serif, serif);
    font-size: 1.1rem;
    line-height: 2;
    margin-bottom: 2.5rem;
  }

  .section-heading {
    border: none;
    padding: 0;
    text-align: center;
    margin-bottom: 2.5rem;
    font-size: 1.5rem;
  }

  /* ==========================================
     1. Latest Featured Card Style (LATEST 영역)
     ========================================== */
  .featured-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .main-featured-card {
    position: relative;
    display: block;
    max-width: 620px;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    text-decoration: none !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .main-featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
  }

  /* 배경 이미지 (블러 & 확대) */
  .featured-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(10px);
    transform: scale(1.15);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .main-featured-card:hover .featured-bg {
    filter: blur(4px);
    transform: scale(1.2);
  }

  /* 텍스트 가독성을 위한 어두운 오버레이 레이어 */
  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.55) 60%,
      rgba(0, 0, 0, 0.4) 100%
    );
    transition: background 0.3s ease;
  }

  .main-featured-card:hover .featured-overlay {
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.65) 60%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* 내부 콘텐츠 레이어 */
  .featured-content {
    position: relative;
    z-index: 2;
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: #ffffff;
    text-align: left;
  }

  .featured-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .badge {
    font-size: 0.65rem;
    background: #ffffff;
    color: #111111;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
  }

  .featured-header time {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-mono, monospace);
  }

  .featured-title {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .featured-arrow {
    font-size: 1.2rem;
    opacity: 0.85;
    color: #ffffff;
    transition: transform 0.2s ease, opacity 0.2s ease;
    flex-shrink: 0;
  }

  .main-featured-card:hover .featured-arrow {
    opacity: 1;
    transform: translateX(5px);
  }

  /* ==========================================
     2. Recent Posts Card Style (최근의 기록들)
     ========================================== */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
    text-align: left;
  }

  @media (max-width: 768px) {
    .recent-grid {
      grid-template-columns: 1fr;
    }
  }

  .recent-card-blur {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 300px;
  }

  .recent-card-blur:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.22);
  }

  .recent-card-blur a {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    position: relative;
  }

  .card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(10px);
    transform: scale(1.12);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .recent-card-blur:hover .card-bg {
    filter: blur(4px);
    transform: scale(1.18);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.75) 100%
    );
    transition: background 0.3s ease;
  }

  .recent-card-blur:hover .card-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    color: #ffffff;
  }

  .card-content time {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-mono, monospace);
    margin-bottom: 0.75rem;
  }

  .card-content h3 {
    margin: 0 0 0.75rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.45;
    color: #ffffff;
    word-break: keep-all;
  }

  .card-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-size: 0.8rem;
    font-weight: 500;
    color: #ffffff;
    margin-top: auto;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .recent-card-blur:hover .read-more {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .featured-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .featured-title {
      white-space: normal;
    }
    .featured-arrow {
      display: none;
    }
  }
</style>