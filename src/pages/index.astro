---
// src/pages/index.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/global.css';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);
---

<!doctype html>
<html lang="ko" class="index-html">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="index-body">
		<Header />
		
		<main class="home-snap-container">
			<!-- Section 1: Hero & Main Journal Intro -->
			<section class="snap-section hero-section">
				<div class="section-inner">
					<span class="sub-label">LUNA SONATA JOURNAL</span>
					<h1 class="hero-title">기록은 삶을 선명하게 만든다</h1>
					<p class="hero-description">
						생각의 깊이, 일상의 온기, 그리고 발걸음이 머문 풍경.<br/>
						세광의 프라이빗 저널에 오신 것을 환영합니다.
					</p>
					{featuredPost && (
						<a href={`/${featuredPost.id}/`} class="main-featured-link">
							<span class="badge">LATEST</span>
							<span class="title">{featuredPost.data.title}</span>
						</a>
					)}
				</div>
			</section>

			<!-- Section 2: Recent Posts Summary -->
			<section class="snap-section archive-section">
				<div class="section-inner">
					<h2 class="section-heading">최근의 기록들</h2>
					<div class="minimal-post-list">
						{recentPosts.map(post => (
							<article class="post-item">
								<a href={`/${post.id}/`}>
									<time><FormattedDate date={post.data.pubDate} /></time>
									<h3>{post.data.title}</h3>
								</a>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* 데스크톱: 한 화면 원페이지 몰입형 스냅 스크롤 */
	@media (min-width: 769px) {
		.index-html, .index-body {
			height: 100%;
			overflow: hidden;
		}
		.home-snap-container {
			height: calc(100vh - 120px);
			overflow-y: mandatory;
			scroll-snap-type: y mandatory;
		}
		.snap-section {
			height: 100%;
			scroll-snap-align: start;
			display: flex;
			align-items: center;
			justify-content: center;
		}
	}

	/* 모바일: 자연스러운 세로 스크롤 레이아웃 */
	@media (max-width: 768px) {
		.snap-section {
			padding: 4rem 1.5rem;
		}
	}

	.section-inner {
		max-width: var(--content-width);
		width: 100%;
		margin: 0 auto;
		text-align: center;
	}

	.sub-label {
		font-size: 0.75rem;
		letter-spacing: 0.25em;
		color: var(--text-muted);
		display: block;
		margin-bottom: 1rem;
	}

	.hero-title {
		margin-bottom: 1.5rem;
	}

	.hero-description {
		color: var(--text-secondary);
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 2;
		margin-bottom: 2.5rem;
	}

	.main-featured-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		text-decoration: none;
		color: var(--text-primary);
		font-size: 0.9rem;
		transition: border-color 0.2s ease;
	}

	.main-featured-link:hover {
		border-color: var(--accent-color);
	}

	.badge {
		font-size: 0.7rem;
		background: var(--accent-color);
		color: #fff;
		padding: 0.1rem 0.4rem;
		letter-spacing: 0.05em;
	}

	.section-heading {
		border: none;
		padding: 0;
		text-align: center;
		margin-bottom: 2rem;
	}

	.minimal-post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-align: left;
	}

	.post-item a {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		text-decoration: none;
		color: var(--text-primary);
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--border-color);
	}

	.post-item time {
		font-size: 0.8rem;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.post-item h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 500;
	}
</style>