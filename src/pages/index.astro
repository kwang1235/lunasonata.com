---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// 홈 전용 CSS 연결
import '../styles/home.css';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-container">
			
			<!-- 1. 히어로 대문 섹션 -->
			<section class="hero-section reveal">
				<div class="hero-overlay"></div>
				<div class="hero-content">
					<p class="hero-sub">Daily, Travel, and Episodes</p>
					<h1 class="hero-title">일상의 조각들을<br />기록하는 아늑한 방</h1>
					<p class="hero-desc">평범한 날들 속에서 반짝이는 순간들을 붙잡아 둡니다.</p>
					<a href="/blog" class="hero-btn">기록 읽으러 가기</a>
				</div>
			</section>

			<!-- 2. 카테고리 서랍 섹션 -->
			<section class="intro-cards-section reveal">
				<div class="section-overlay"></div>
				<div class="section-content-wrapper">
					<h2 class="section-title">소소한 기록들의 서랍</h2>
					<div class="cards-grid">
						
						<!-- 카테고리 1: 일상 생각 -->
						<a href="/category/diary/" class="intro-card">
							<div class="card-icon-svg">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
							</div>
							<h3>일상 생각 (Diary)</h3>
							<p>스쳐 지나가는 생각과 감정들을 가만히 글로 적어 내려갑니다.</p>
						</a>

						<!-- 카테고리 2: 길 위에서 -->
						<a href="/category/travel/" class="intro-card">
							<div class="card-icon-svg">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
							</div>
							<h3>길 위에서 (Travel)</h3>
							<p>낯선 풍경과 그 안에서 마주한 사람들의 이야기를 기록합니다.</p>
						</a>

						<!-- 카테고리 3: 에피소드 -->
						<a href="/category/episodes/" class="intro-card">
							<div class="card-icon-svg">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="m3 9 18-3"></path><path d="m3 14 18-3"></path><path d="M9 3v18"></path></svg>
							</div>
							<h3>에피소드 (Episodes)</h3>
							<p>하루하루 속에서 일어나는 유쾌하고 따뜻한 순간의 포착.</p>
						</a>

					</div>
				</div>
			</section>

			<!-- 3. 아웃트로 섹션 -->
			<section class="outro-section reveal">
				<div class="outro-overlay"></div>
				<div class="outro-content">
					<p class="outro-text">"오늘도 제 방에 머물러 주셔서 고맙습니다."</p>
					<span>언제든 당신의 따뜻한 시선과 생각을 나누어 주세요.</span>
				</div>
			</section>

		</main>
		<Footer />

		<!-- 동적 페이드인 스크립트 -->
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const revealElements = document.querySelectorAll('.reveal');
				
				const observerOptions = {
					root: null,
					rootMargin: '0px',
					threshold: 0.15
				};

				const revealCallback = function(entries, observer) {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
							observer.unobserve(entry.target);
						}
					});
				};

				const observer = new IntersectionObserver(revealCallback, observerOptions);
				revealElements.forEach(element => {
					observer.observe(element);
				});
			});
		</script>
	</body>
</html>