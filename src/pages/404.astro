---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko" class="error-html">
  <head>
    <BaseHead
      title={`페이지를 찾을 수 없습니다 - ${SITE_TITLE}`}
      description="요청하신 페이지가 존재하지 않거나 이동되었습니다."
      noindex={true}
    />
    <style>
      /* 1. 화면 전체 높이 강제 및 중앙 정렬 */
      :global(html.error-html),
      :global(html.error-html body) {
        height: 100% !important;
        min-height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden;
      }

      :global(html.error-html body) {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background-color: var(--bg-body, #fafaf9) !important;
        position: relative;
      }

      /* 배경 은은한 오로라 애니메이션 */
      .bg-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(92, 98, 85, 0.12) 0%, rgba(92, 98, 85, 0) 70%);
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 0;
        animation: glowPulse 6s ease-in-out infinite alternate;
      }

      @keyframes glowPulse {
        0% { transform: translate(-50%, -50%) scale(0.85); opacity: 0.5; }
        100% { transform: translate(-50%, -50%) scale(1.25); opacity: 0.9; }
      }

      /* 2. 중앙 컨테이너 */
      .error-wrapper {
        width: 100%;
        max-width: 620px;
        padding: 2rem 1.25rem;
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-sizing: border-box;
        position: relative;
        z-index: 1;
      }

      /* 404 안내 뱃지 */
      .badge-404 {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.85rem;
        background: rgba(92, 98, 85, 0.08);
        border: 1px solid rgba(92, 98, 85, 0.18);
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--accent-color, #5c6255);
        margin-bottom: 0.85rem;
        animation: badgePulse 3s ease-in-out infinite;
      }

      @keyframes badgePulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.03); background: rgba(92, 98, 85, 0.13); }
      }

      /* 404 큰 숫자 (부유 애니메이션) */
      .error-code {
        font-size: clamp(4rem, 15vw, 6.5rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.04em;
        margin: 0 0 0.75rem 0;
        background: linear-gradient(135deg, #1e293b 30%, #5c6255 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: floatNumber 4s ease-in-out infinite;
      }

      @keyframes floatNumber {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-7px); }
      }

      .error-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--heading-color, #1e293b);
        margin: 0 0 0.6rem 0;
        word-break: keep-all;
      }

      .error-desc {
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--text-muted, #64748b);
        margin: 0 0 1.75rem 0;
        word-break: keep-all;
      }

      /* 메인 액션 버튼 */
      .action-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        width: 100%;
        max-width: 440px;
        margin-bottom: 1.75rem;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.8rem 1rem;
        background-color: var(--accent-color, #5c6255);
        color: #ffffff !important;
        font-size: 0.92rem;
        font-weight: 600;
        border-radius: 12px;
        text-decoration: none !important;
        box-shadow: 0 4px 12px rgba(92, 98, 85, 0.2);
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      .btn-primary:hover {
        background-color: #4a4f44;
        transform: translateY(-2px);
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.8rem 1rem;
        background-color: #ffffff;
        color: #1e293b !important;
        border: 1px solid #cbd5e1;
        font-size: 0.92rem;
        font-weight: 600;
        border-radius: 12px;
        text-decoration: none !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      .btn-secondary:hover {
        background-color: #f8fafc;
        transform: translateY(-2px);
      }

      /* 둘러보기 카드 */
      .quick-links-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
        box-sizing: border-box;
      }

      .quick-links-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        font-size: 0.88rem;
        font-weight: 700;
        color: #334155;
        margin: 0 0 0.85rem 0;
      }

      /* 🧭 나침반 회전 탐색 애니메이션 */
      .icon-compass {
        animation: searchSpin 5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
        transform-origin: center center;
      }

      @keyframes searchSpin {
        0% { transform: rotate(0deg); }
        30% { transform: rotate(35deg); }
        60% { transform: rotate(-25deg); }
        85% { transform: rotate(15deg); }
        100% { transform: rotate(0deg); }
      }

      .quick-links-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
      }

      .quick-link-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.75rem 0.4rem;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        text-decoration: none !important;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
      }

      .quick-link-item:hover {
        background: rgba(92, 98, 85, 0.08);
        border-color: rgba(92, 98, 85, 0.2);
        color: var(--accent-color, #5c6255);
        transform: translateY(-2px);
      }

      /* SVG 아이콘 크기 고정 */
      .svg-icon {
        width: 17px !important;
        height: 17px !important;
        min-width: 17px !important;
        max-width: 17px !important;
        display: inline-block !important;
        flex-shrink: 0 !important;
      }

      /* 📱 모바일 최적화 (640px 이하) */
      @media (max-width: 640px) {
        .error-wrapper {
          padding: 1.5rem 1rem;
        }

        .error-title {
          font-size: 1.2rem;
        }

        .error-desc {
          font-size: 0.85rem;
          margin-bottom: 1.5rem;
        }

        .action-buttons {
          grid-template-columns: 1fr;
          gap: 0.6rem;
          margin-bottom: 1.5rem;
        }

        .btn-primary, .btn-secondary {
          padding: 0.85rem 1rem;
          width: 100%;
          box-sizing: border-box;
        }

        .quick-links-grid {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }

        .quick-link-item {
          flex-direction: row;
          padding: 0.75rem;
          gap: 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- 배경 은은한 오로라 원 -->
    <div class="bg-glow"></div>

    <main class="error-wrapper">
      <div class="badge-404">
        <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>길을 잃으셨나요?</span>
      </div>

      <h1 class="error-code">404</h1>
      <h2 class="error-title">찾으시는 페이지를 찾을 수 없습니다</h2>
      <p class="error-desc">
        주소가 잘못 입력되었거나, 삭제되어 페이지를 찾을 수 없습니다.<br />
        입력하신 주소를 다시 한번 확인해 주세요.
      </p>

      <div class="action-buttons">
        <a href="/" class="btn-primary">
          <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          홈으로 돌아가기
        </a>
        <a href="/blog/" class="btn-secondary">
          <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          블로그 글 둘러보기
        </a>
      </div>

      <div class="quick-links-card">
        <div class="quick-links-title">
          <!-- 🧭 좌우로 천천히 회전하는 나침반 아이콘 -->
          <svg class="svg-icon icon-compass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
          <span>다른 페이지 둘러보기</span>
        </div>
        <div class="quick-links-grid">
          <a href="/" class="quick-link-item">
            <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>메인 홈</span>
          </a>
          <a href="/blog/" class="quick-link-item">
            <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>전체 글 목록</span>
          </a>
          <a href="/about/" class="quick-link-item">
            <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>블로그 소개</span>
          </a>
        </div>
      </div>
    </main>
  </body>
</html>