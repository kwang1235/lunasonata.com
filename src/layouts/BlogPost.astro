    </style>

    <script>
      function initBlogPost() {
        // 1. 스크롤 진행률 & 플로팅 버튼
        const progressBar = document.getElementById('progress-bar');
        const topBtn = document.getElementById('back-to-top');

        window.addEventListener('scroll', () => {
          const winScroll = window.pageYOffset || document.documentElement.scrollTop;
          const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          
          let scrolled = 0;
          if (totalHeight > 0) {
            scrolled = Math.min(100, Math.max(0, (winScroll / totalHeight) * 100));
          }
          
          if (progressBar) progressBar.style.width = `${scrolled}%`;

          if (winScroll > 300) {
            topBtn?.classList.add('visible');
          } else {
            topBtn?.classList.remove('visible');
          }
        }, { passive: true });

        topBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          if (window.pageYOffset > 0) {
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
          }
        });

        // 2. 본문 읽기 시간 자동 계산
        const prose = document.getElementById('prose-content');
        const readingTimeText = document.getElementById('reading-time-text');

        if (prose && readingTimeText) {
          const text = prose.textContent || '';
          const charCount = text.trim().length;
          const minutes = Math.max(1, Math.ceil(charCount / 500));
          readingTimeText.textContent = `약 ${minutes}분 읽기`;
        }

        // 3. 본문 이미지 돋보기 힌트 레이어 동적 생성 (중복 생성 방지 강화)
        const proseImages = document.querySelectorAll<HTMLImageElement>('.prose img:not(.no-hover-wrap)');
        
        proseImages.forEach((img) => {
          const parent = img.parentElement;
          if (parent && !parent.classList.contains('image-hover-wrapper') && !parent.querySelector('.zoom-hint-overlay')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'image-hover-wrapper';

            const overlay = document.createElement('div');
            overlay.className = 'zoom-hint-overlay';
            overlay.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
              <span>클릭하여 확대</span>
            `;

            if (parent.tagName === 'P' && parent.children.length === 1 && parent.textContent?.trim() === '') {
              wrapper.appendChild(img);
              wrapper.appendChild(overlay);
              parent.replaceWith(wrapper);
            } else {
              parent.insertBefore(wrapper, img);
              wrapper.appendChild(img);
              wrapper.appendChild(overlay);
            }
          }
        });

        // 4. 모달 갤러리
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalStage = document.getElementById('modal-stage');
        const closeBtn = document.getElementById('modal-close');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const thumbnailList = document.getElementById('thumbnail-list');

        const allImages = Array.from(
          document.querySelectorAll<HTMLImageElement>('.prose img:not(.no-lightbox)')
        ).filter((img) => img.src && img.src.trim() !== '');

        let currentIndex = 0;
        let isZoomed = false;
        let isDragging = false;
        let hasDragged = false;
        let startX = 0;
        let startY = 0;
        let translateX = 0;
        let translateY = 0;
        let currentX = 0;
        let currentY = 0;

        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;

        function resetZoom() {
          isZoomed = false;
          isDragging = false;
          hasDragged = false;
          translateX = 0;
          translateY = 0;
          currentX = 0;
          currentY = 0;
          if (modalImg) {
            modalImg.classList.remove('zoomed');
            modalImg.style.transform = 'translate(0px, 0px) scale(1)';
          }
        }

        function updateModalImage(index: number) {
          if (!allImages.length || !modalImg) return;
          
          resetZoom();
          currentIndex = (index + allImages.length) % allImages.length;
          
          const targetImg = allImages[currentIndex];
          modalImg.src = targetImg.currentSrc || targetImg.src;
          modalImg.alt = targetImg.alt || '확대 이미지';

          const thumbs = thumbnailList?.querySelectorAll('.thumb-item');
          thumbs?.forEach((thumb, i) => {
            if (i === currentIndex) {
              thumb.classList.add('active');
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              thumb.classList.remove('active');
            }
          });
        }

        function buildThumbnails() {
          if (!thumbnailList) return;
          thumbnailList.innerHTML = ''; // 재진입 시 중복 추가 방지

          allImages.forEach((img, i) => {
            const thumb = document.createElement('img');
            thumb.src = img.currentSrc || img.src;
            thumb.className = 'thumb-item';
            thumb.alt = `썸네일 ${i + 1}`;
            thumb.addEventListener('click', (e) => {
              e.stopPropagation();
              updateModalImage(i);
            });
            thumbnailList.appendChild(thumb);
          });
        }

        function openModal(index: number) {
          if (!modal) return;
          buildThumbnails();

          // 이미지가 1장뿐이면 좌우 화살표와 썸네일 바 숨김 처리
          const isSingle = allImages.length <= 1;
          if (prevBtn) prevBtn.style.display = isSingle ? 'none' : 'flex';
          if (nextBtn) nextBtn.style.display = isSingle ? 'none' : 'flex';
          const thumbBar = modal.querySelector('.floating-thumbnail-bar') as HTMLElement | null;
          if (thumbBar) thumbBar.style.display = isSingle ? 'none' : 'flex';

          modal.classList.add('open');
          document.body.style.overflow = 'hidden';
          updateModalImage(index);

          // 브라우저 뒤로 가기 시 모달만 닫히도록 히스토리 추가
          if (window.location.hash !== '#modal-open') {
            history.pushState({ modalOpen: true }, '', '#modal-open');
          }
        }

        function closeModal() {
          if (modal && modal.classList.contains('open')) {
            resetZoom();
            modal.classList.remove('open');
            document.body.style.removeProperty('overflow');

            if (history.state?.modalOpen || window.location.hash === '#modal-open') {
              history.back();
            }
          }
        }

        // 🔙 스마트폰 제스처/브라우저 뒤로가기 버튼 클릭 시 모달 닫기 감지
        window.addEventListener('popstate', () => {
          if (modal && modal.classList.contains('open')) {
            resetZoom();
            modal.classList.remove('open');
            document.body.style.removeProperty('overflow');
          }
        });

        window.addEventListener('popstate', () => {
          if (modal && modal.classList.contains('open')) {
            modal.classList.remove('open');
            document.body.style.removeProperty('overflow');
            resetZoom();
          }
        });

        allImages.forEach((img, index) => {
          img.style.cursor = 'pointer';
          img.addEventListener('click', () => openModal(index));
        });

        let touchMoveStartX = 0;
        let touchMoveStartY = 0;

        // 모달 활성화 시 마우스 휠 조작 최적화 (확대 중엔 기본 차단, 일반 상태에선 사진 넘김 지원)
        let wheelTimeout: NodeJS.Timeout | number | null = null;
        modalStage?.addEventListener('wheel', (e: WheelEvent) => {
          e.preventDefault();
          if (isZoomed) return;

          if (!wheelTimeout) {
            if (e.deltaY > 30) {
              updateModalImage(currentIndex + 1); // 휠 아래로 내리면 다음 사진
            } else if (e.deltaY < -30) {
              updateModalImage(currentIndex - 1); // 휠 위로 올리면 이전 사진
            }
            wheelTimeout = setTimeout(() => {
              wheelTimeout = null;
            }, 250); // 연속 스크롤로 인한 폭주 방지 쿨타임
          }
        }, { passive: false });
        modalStage?.addEventListener('touchstart', (e: TouchEvent) => {
          if (isZoomed) {
            touchMoveStartX = e.touches[0].clientX - currentX;
            touchMoveStartY = e.touches[0].clientY - currentY;
            return;
          }
          touchStartX = e.changedTouches[0].clientX;
          touchStartY = e.changedTouches[0].clientY;
        }, { passive: true });

        modalStage?.addEventListener('touchmove', (e: TouchEvent) => {
          if (!isZoomed || !modalImg) return;
          e.preventDefault(); // 확대 상태에서 아래로 당길 때 브라우저 새로고침 방지
          translateX = e.touches[0].clientX - touchMoveStartX;
          translateY = e.touches[0].clientY - touchMoveStartY;
          modalImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(1.8)`;
        }, { passive: false });

        modalStage?.addEventListener('touchend', (e: TouchEvent) => {
          if (isZoomed) {
            currentX = translateX;
            currentY = translateY;
            return;
          }
          touchEndX = e.changedTouches[0].clientX;
          touchEndY = e.changedTouches[0].clientY;

          handleSwipe();
        }, { passive: true });

        function handleSwipe() {
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
          const threshold = 50; // 확실한 좌우 스와이프 감지 기준값

          // 수평 이동 거리가 수직 이동 거리의 1.5배 이상일 때만 안정적으로 슬라이드 전환
          if (Math.abs(diffX) > Math.abs(diffY) * 1.5 && Math.abs(diffX) > threshold) {
            if (diffX < 0) {
              updateModalImage(currentIndex + 1); // 왼쪽으로 밀면 다음 사진
            } else {
              updateModalImage(currentIndex - 1); // 오른쪽으로 밀면 이전 사진
            }
          }
        }

        modalImg?.addEventListener('click', (e) => {
          e.stopPropagation();

          if (hasDragged) {
            hasDragged = false;
            return;
          }

          isZoomed = !isZoomed;
          if (isZoomed && modalImg) {
            modalImg.classList.add('zoomed');
            modalImg.style.transform = 'translate(0px, 0px) scale(1.8)';
          } else {
            resetZoom();
          }
        });

        modalImg?.addEventListener('mousedown', (e) => {
          if (!isZoomed) return;
          e.preventDefault(); // 드래그 중 파란색 블록 선택 방지
          isDragging = true;
          hasDragged = false;
          startX = e.clientX - currentX;
          startY = e.clientY - currentY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging || !isZoomed || !modalImg) return;
          e.preventDefault();

          if (Math.abs(e.clientX - (startX + currentX)) > 3 || Math.abs(e.clientY - (startY + currentY)) > 3) {
            hasDragged = true;
          }

          translateX = e.clientX - startX;
          translateY = e.clientY - startY;
          modalImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(1.8)`;
        });

        function stopDragging() {
          if (isDragging) {
            isDragging = false;
            currentX = translateX;
            currentY = translateY;
          }
        }

        window.addEventListener('mouseup', stopDragging);
        window.addEventListener('mouseleave', stopDragging);
        window.addEventListener('blur', stopDragging);
        closeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          closeModal();
        });

        modal?.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('image-modal') || target.classList.contains('modal-stage')) {
            resetZoom();
            closeModal();
          }
        });

        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex - 1);
        });

        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex + 1);
        });

        function handleKeyDown(e: KeyboardEvent) {
          if (!modal || !modal.classList.contains('open')) return;

          if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            resetZoom();
            updateModalImage(currentIndex - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            resetZoom();
            updateModalImage(currentIndex + 1);
          } else if (['ArrowUp', 'ArrowDown', ' '].includes(e.key)) {
            // 모달 활성화 중 배경 스크롤 방지
            e.preventDefault();
          }
        }

        // 페이지 재진입 시 이벤트 리스너 중복 누적 방지
        document.removeEventListener('keydown', handleKeyDown);
        document.addEventListener('keydown', handleKeyDown);

        // 5. 목차(TOC) 생성 & 스크롤 위치별 PC 좌측 플로팅 전환 & 하이라이트
        const tocContainer = document.getElementById('toc-container');
        const tocList = document.getElementById('toc-list');
        const toggleBtn = document.getElementById('toc-toggle-btn');

        if (!prose || !tocContainer || !tocList) return;

        const h2Elements = Array.from(prose.querySelectorAll('h2'));

        // 본문에 h2가 없으면 목차 영역을 완전히 숨기고 이후 불필요한 이벤트 등록 중단
        if (h2Elements.length === 0) {
          tocContainer.style.display = 'none';
          tocContainer.classList.remove('is-floating');
          return;
        }

        tocContainer.style.display = 'block';
        tocList.innerHTML = ''; // 재진입 시 목차 목록 초기화

        h2Elements.forEach((h2, index) => {
          const rawText = (h2.textContent || '').trim().replace(/\s+/g, ' ');

          if (!h2.id) {
            // 한글, 영문, 숫자, 하이픈 외 특수문자/이모지 제거 및 앞뒤 하이픈 정리
            const cleanSlug = rawText
              .toLowerCase()
              .replace(/[^\w\sㄱ-ㅎ가-힣-]/g, '')
              .trim()
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-');
            h2.id = cleanSlug ? `toc-${cleanSlug}-${index}` : `heading-${index}`;
          }

          const li = document.createElement('li');
          li.className = 'toc-item';

          const a = document.createElement('a');
          a.className = 'toc-link';
          a.href = `#${h2.id}`;
          a.textContent = rawText;

          a.addEventListener('click', (e) => {
            e.preventDefault();
            const targetElement = document.getElementById(h2.id);
            if (targetElement) {
              // 클릭 즉시 목차 활성 상태 피드백 반영
              document.querySelectorAll('.toc-link').forEach((link) => link.classList.remove('active'));
              a.classList.add('active');

              const headerOffset = 90;
              const elementPosition = targetElement.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

              window.scrollTo({
                top: offsetPosition,
                behavior: 'smooth'
              });

              // 뒤로 가기 히스토리를 더럽히지 않고 URL 해시 안전하게 갱신
              history.replaceState(null, '', `#${h2.id}`);
            }
          });

          li.appendChild(a);
          tocList.appendChild(li);
        });

        toggleBtn?.addEventListener('click', () => {
          tocContainer.classList.toggle('collapsed');
        });

        function handleTocFloating() {
          if (!tocContainer || !prose) return;

          if (window.innerWidth >= 1360) {
            const proseRect = prose.getBoundingClientRect();
            // 본문 영역이 상단 네비게이션 아래로 진입했을 때 플로팅 활성화
            if (proseRect.top < 100 && proseRect.bottom > 200) {
              tocContainer.classList.add('is-floating');
            } else {
              tocContainer.classList.remove('is-floating');
            }
          } else {
            tocContainer.classList.remove('is-floating');
          }
        }

        window.addEventListener('scroll', handleTocFloating, { passive: true });
        window.addEventListener('resize', handleTocFloating, { passive: true });
        // 페이지 진입 즉시 1회 실행하여 현재 스크롤 위치에 맞춤
        handleTocFloating();
        // 이전 옵저버가 살아있다면 연결 해제
        if ((window as any).__tocObserver) {
          (window as any).__tocObserver.disconnect();
        }

        const observerOptions = {
          root: null,
          rootMargin: '-80px 0px -60% 0px',
          threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              document.querySelectorAll('.toc-link').forEach((link) => {
                if (link.getAttribute('href') === `#${id}`) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          });
        }, observerOptions);

        h2Elements.forEach((h2) => observer.observe(h2));
        (window as any).__tocObserver = observer;

        // 6. 코드 블록(pre) 복사 버튼 자동 생성 및 클립보드 복사 기능
        if (prose) {
          const preBlocks = prose.querySelectorAll('pre');
          preBlocks.forEach((pre) => {
            // 중복 생성 방지
            if (pre.querySelector('.copy-code-button')) return;

            (pre as HTMLElement).style.position = 'relative';

            const copyBtn = document.createElement('button');
            copyBtn.className = 'copy-code-button';
            copyBtn.type = 'button';
            copyBtn.innerText = '복사';
            copyBtn.setAttribute('aria-label', '코드 복사');

            copyBtn.addEventListener('click', async () => {
              const codeText = pre.querySelector('code')?.innerText || pre.innerText;
              try {
                await navigator.clipboard.writeText(codeText.trim());
                copyBtn.innerText = '복사됨!';
                copyBtn.style.color = '#4ade80';

                setTimeout(() => {
                  copyBtn.innerText = '복사';
                  copyBtn.style.color = '#e2e8f0';
                }, 2000);
              } catch (err) {
                copyBtn.innerText = '실패';
                setTimeout(() => {
                  copyBtn.innerText = '복사';
                }, 2000);
              }
            });

            pre.appendChild(copyBtn);
          });
        }

        // 7. 본문 외부 링크 새 창 열기 및 보안 속성 자동 적용
        if (prose) {
          const links = prose.querySelectorAll('a');
          links.forEach((link) => {
            const href = link.getAttribute('href');
            if (href && (href.startsWith('http://') || href.startsWith('https://')) && !href.includes(window.location.hostname)) {
              link.setAttribute('target', '_blank');
              link.setAttribute('rel', 'noopener noreferrer');
            }
          });
        }

        // 8. 글 공유 기능 (모바일 시스템 공유 & PC 클립보드 링크 복사 지원)
        const shareBtn = document.getElementById('share-btn');
        if (shareBtn) {
          shareBtn.onclick = async () => {
            const shareData = {
              title: document.title,
              url: window.location.href
            };

            if (navigator.share) {
              try {
                await navigator.share(shareData);
              } catch (err) {
                // 사용자가 공유 창을 닫은 경우 무시
              }
            } else {
              try {
                await navigator.clipboard.writeText(window.location.href);
                alert('링크가 클립보드에 복사되었습니다.');
              } catch (err) {
                const tempInput = document.createElement('input');
                tempInput.value = window.location.href;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                alert('링크가 클립보드에 복사되었습니다.');
              }
            }
          };
        }
      }

      // 📊 반응형 테이블 마우스 휠 가로 스크롤 지원
      const tableContainers = document.querySelectorAll('.table-container');
      tableContainers.forEach((container) => {
        container.addEventListener('wheel', (e) => {
          // 세로 스크롤 휠 입력을 감지하여 가로 스크롤로 부드럽게 전달
          if (e.deltaY !== 0 && container.scrollWidth > container.clientWidth) {
            e.preventDefault();
            container.scrollLeft += e.deltaY;
          }
        }, { passive: false });
      });

      // Astro 페이지 로드 및 일반 DOM 로드 모두 지원
      document.addEventListener('DOMContentLoaded', initBlogPost);
      document.addEventListener('astro:page-load', initBlogPost);
    </script>
  </body>
</html>