---
// src/layouts/BlogPost.astro
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import LikeShare from '../components/LikeShare.astro'; 
import InArticleAd from '../components/InArticleAd.astro';
import { SITE_TITLE, DEFAULT_OG_IMAGE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
  noindex?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, noindex = false, categories = [], category = '' } = Astro.props;

const postCategories: string[] = Array.isArray(categories) && categories.length > 0
  ? categories
  : typeof category === 'string' && category.trim() !== ''
  ? [category.trim()]
  : [];

const rawImage = typeof heroImage === 'object' && heroImage !== null && 'src' in heroImage 
  ? heroImage.src 
  : heroImage;

const displayHeroImage = rawImage || DEFAULT_OG_IMAGE;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={displayHeroImage} noindex={noindex} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": displayHeroImage ? [new URL(displayHeroImage, Astro.site || Astro.url.origin).toString()] : [],
      "datePublished": (!isNaN(new Date(pubDate).getTime())) ? new Date(pubDate).toISOString() : new Date().toISOString(),
      ...(updatedDate && !isNaN(new Date(updatedDate).getTime()) && { "dateModified": new Date(updatedDate).toISOString() }),
      "author": {
        "@type": "Person",
        "name": SITE_TITLE
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.toString()
      }
    })} />
  </head>

  <body>
    <!-- 상단 스크롤 진행 바 -->
    <div id="progress-bar" class="progress-bar"></div>

    <Header />

    <main class="article-container">
      <article>
        <!-- 포스트 상단 헤더 -->
        <header 
          class="post-header" 
          style={displayHeroImage ? `background-image: linear-gradient(rgba(15, 23, 42, 0.65), rgba(15, 23, 42, 0.65)), url('${displayHeroImage}');` : ''}
        >
          {postCategories.length > 0 && (
            <div class="post-categories-row">
              {postCategories.map((cat) => (
                <a href={`/category/${cat}/`} class="post-header-tag">
                  #{cat}
                </a>
              ))}
            </div>
          )}
          <div class="post-meta-row">
            <span class="post-date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <span class="last-updated">
                  (수정: <FormattedDate date={updatedDate} />)
                </span>
              )}
            </span>
            <span class="meta-divider">•</span>
            <span class="reading-time">
              <svg class="reading-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span id="reading-time-text">읽는 중...</span>
            </span>
          </div>
          <h1 class="post-title">{title}</h1>
        </header>

        <!-- 목차 (TOC) -->
        <nav id="toc-container" class="toc-container" aria-label="목차">
          <div class="toc-header">
            <div class="toc-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>목차</span>
            </div>
            <button id="toc-toggle-btn" class="toc-toggle-btn" aria-label="목차 접기/열기">
              <svg id="toc-toggle-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          </div>
          <div id="toc-wrapper" class="toc-wrapper">
            <ul id="toc-list" class="toc-list"></ul>
          </div>
        </nav>

        <!-- 본문 영역 (global.css 및 작성 시 직접 주는 CSS만 반영) -->
        <div class="prose" id="prose-content">
          <div class="ad-block">
            <InArticleAd />
          </div>

          <slot />

          <div class="ad-block">
            <InArticleAd />
          </div>

          <LikeShare title={title} />  
        </div>
      </article>
    </main>

    <!-- 맨 위로 이동 플로팅 버튼 -->
    <button id="back-to-top" class="floating-top-btn" aria-label="맨 위로 이동">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- 🖼️ 고급 이미지 갤러리 모달 (라이트박스 원본 완벽 복원) -->
    <div id="image-modal" class="image-modal">
      <button class="modal-close" id="modal-close" aria-label="닫기">&times;</button>
      
      <div class="modal-stage" id="modal-stage">
        <div class="img-container">
          <img id="modal-img" class="modal-content" title="클릭 시 확대/축소, 확대 후 마우스 드래그로 이동" draggable="false" />
        </div>
      </div>

      <button class="nav-btn prev-btn" id="prev-btn" aria-label="이전 이미지">&lsaquo;</button>
      <button class="nav-btn next-btn" id="next-btn" aria-label="다음 이미지">&rsaquo;</button>

      <div class="floating-thumbnail-bar">
        <div id="thumbnail-list" class="thumbnail-list"></div>
      </div>
    </div>

    <Footer />

    <style>
      /* 1. 레이아웃 기본 */
      .article-container {
        width: 100%;
        max-width: var(--content-width, 760px);
        margin: 0 auto;
        padding: 3rem 1.25rem;
        position: relative;
        box-sizing: border-box;
      }

      .progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background-color: var(--accent-color, #5c6255);
        width: 0%;
        z-index: 9999;
        transition: width 0.1s ease-out;
      }

      /* 2. 포스트 헤더 */
      .post-header {
        text-align: center;
        margin-bottom: 2.5rem;
        padding: 4rem 2rem;
        border-radius: 16px;
        background-color: #1e293b;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }

      .post-header .post-meta-row { color: rgba(255, 255, 255, 0.85); }
      .post-header .reading-time { color: #f1f5f9; }
      .post-header .meta-divider { color: rgba(255, 255, 255, 0.4); }

      .post-title {
        font-size: 2.1rem;
        font-weight: 800;
        color: #ffffff !important;
        line-height: 1.35;
        letter-spacing: -0.02em;
        margin: 0;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      }

      .post-categories-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.85rem;
      }

      .post-header-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        color: #ffffff !important;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none !important;
        transition: background-color 0.2s ease, transform 0.2s ease;
      }

      .post-header-tag:hover {
        background: rgba(255, 255, 255, 0.35);
        transform: translateY(-1px);
      }

      .post-meta-row {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.4rem 0.6rem;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
        line-height: 1.4;
      }

      .meta-divider { color: rgba(255, 255, 255, 0.4); }
      .reading-time {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-weight: 500;
      }

      /* 3. 목차 (TOC) */
      .toc-container {
        display: none;
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(92, 98, 85, 0.12);
        border-radius: 16px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 2.5rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .toc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .toc-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--heading-color, #1e293b);
      }

      .toc-title svg { color: var(--accent-color, #5c6255); }

      .toc-toggle-btn {
        background: rgba(92, 98, 85, 0.06);
        border: 1px solid rgba(92, 98, 85, 0.15);
        border-radius: 8px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        color: var(--accent-color, #5c6255);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .toc-wrapper {
        overflow-y: auto;
        max-height: 400px;
        margin-top: 0.85rem;
        transition: max-height 0.3s ease, opacity 0.2s ease;
      }

      .toc-container.collapsed .toc-wrapper {
        max-height: 0 !important;
        opacity: 0;
        overflow: hidden;
        margin-top: 0;
      }

      .toc-container.collapsed #toc-toggle-icon { transform: rotate(-90deg); }

      .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .toc-list :global(.toc-item) { font-size: 0.88rem; line-height: 1.45; }
      .toc-list :global(.toc-link) {
        color: var(--text-muted, #64748b);
        text-decoration: none;
        display: block;
        border-left: 2px solid transparent;
        padding-left: 8px;
        transition: all 0.2s ease;
      }

      .toc-list :global(.toc-link:hover),
      .toc-list :global(.toc-link.active) {
        color: var(--accent-color, #5c6255);
        font-weight: 700;
        border-left-color: var(--accent-color, #5c6255);
      }

      @media (min-width: 1360px) {
        .toc-container.is-floating {
          position: fixed;
          top: 140px;
          left: calc(50% - 380px - 250px);
          width: 220px;
          max-height: calc(100vh - 180px);
          margin-bottom: 0;
          z-index: 90;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }
      }

      /* 4. 플로팅 버튼 및 광고 */
      .floating-top-btn {
        position: fixed;
        bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
        right: 2rem;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.25s ease;
        z-index: 95;
      }

      .floating-top-btn.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .ad-block {
        margin: 1.5rem 0;
        text-align: center;
      }

      /* 5. 🖼️ 원본 라이트박스 모달 CSS 100% 유지 */
      .image-modal {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-color: rgba(0, 0, 0, 0.92);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding-bottom: env(safe-area-inset-bottom, 0px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }

      .image-modal.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .modal-close {
        position: fixed;
        top: calc(18px + env(safe-area-inset-top, 0px));
        right: calc(20px + env(safe-area-inset-right, 0px));
        color: #ffffff;
        font-size: 2rem;
        line-height: 1;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10006;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.2s, transform 0.2s;
      }

      .modal-close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.05);
      }

      .modal-stage {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: calc(100vh - 100px);
        height: calc(100dvh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px 0 20px;
        box-sizing: border-box;
        z-index: 10001;
        touch-action: pan-y;
      }

      .img-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 85vw;
        max-height: calc(100vh - 140px);
        max-height: calc(100dvh - 140px);
      }

      .modal-content {
        display: block;
        max-width: 85vw;
        max-height: calc(100vh - 140px);
        max-height: calc(100dvh - 140px);
        object-fit: contain;
        cursor: zoom-in;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
        transition: transform 0.2s ease-out;
        transform-origin: center center;
      }

      .modal-content.zoomed {
        cursor: grab;
      }

      .modal-content.zoomed:active {
        cursor: grabbing;
      }

      .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(6px);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.25);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        font-size: 2rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10002;
        -webkit-tap-highlight-color: transparent;
        transition: background 0.2s, transform 0.2s;
      }

      .nav-btn:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-50%) scale(1.05);
      }

      .prev-btn {
        left: calc(1.5rem + env(safe-area-inset-left, 0px));
      }

      .next-btn {
        right: calc(1.5rem + env(safe-area-inset-right, 0px));
      }

      .floating-thumbnail-bar {
        position: absolute;
        bottom: calc(20px + env(safe-area-inset-bottom, 0px)) !important;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        background: rgba(15, 23, 42, 0.82);
        backdrop-filter: blur(10px);
        padding: 8px 16px;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .thumbnail-list {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 80vw;
        padding: 4px 8px;
        margin: 0 auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .thumbnail-list::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
      }

      .thumbnail-list :global(.thumb-item) {
        width: 40px !important;
        height: 40px !important;
        min-width: 40px !important;
        max-width: 40px !important;
        min-height: 40px !important;
        max-height: 40px !important;
        object-fit: cover !important;
        opacity: 0.4 !important;
        cursor: pointer !important;
        border-radius: 8px !important;
        border: 2px solid transparent !important;
        transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease !important;
        flex-shrink: 0 !important;
        display: block !important;
        margin: 0 !important;
      }

      .thumbnail-list :global(.thumb-item.active) {
        opacity: 1 !important;
        border-color: #ffffff !important;
        transform: scale(1.1) !important;
      }

      @media (max-width: 768px) {
        .article-container { padding: 1.25rem 1rem 2.5rem 1rem; }
        .post-title { font-size: 1.6rem; }

        .modal-close {
          top: 12px;
          right: 12px;
          width: 36px;
          height: 36px;
          font-size: 1.5rem;
        }

        .nav-btn {
          width: 36px;
          height: 36px;
          font-size: 1.4rem;
        }
        .prev-btn { left: 0.5rem; }
        .next-btn { right: 0.5rem; }
        
        .floating-thumbnail-bar {
          bottom: calc(12px + env(safe-area-inset-bottom, 0px)) !important;
          height: 48px;
          border-radius: 24px;
          padding: 0 8px;
        }

        .thumbnail-list :global(.thumb-item),
        .thumbnail-list :global(.thumb-item.active) {
          width: 32px !important;
          height: 32px !important;
          min-width: 32px !important;
          max-width: 32px !important;
          min-height: 32px !important;
          max-height: 32px !important;
          flex-shrink: 0 !important;
          aspect-ratio: 1 / 1 !important;
        }
      }
    </style>

    <script>
      let currentCleanup: (() => void) | null = null;

      function initBlogPost() {
        if (currentCleanup) {
          currentCleanup();
          currentCleanup = null;
        }

        const abortController = new AbortController();
        const { signal } = abortController;

        const progressBar = document.getElementById('progress-bar');
        const topBtn = document.getElementById('back-to-top');
        const prose = document.getElementById('prose-content');
        const readingTimeText = document.getElementById('reading-time-text');

        // 1. 스크롤 진행률 & 상단 이동 버튼
        const handleScroll = () => {
          const winScroll = window.pageYOffset || document.documentElement.scrollTop;
          const totalHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          if (totalHeight > 0 && progressBar) {
            progressBar.style.width = `${Math.min(100, Math.max(0, (winScroll / totalHeight) * 100))}%`;
          }
          if (topBtn) {
            topBtn.classList.toggle('visible', winScroll > 300);
          }
        };

        window.addEventListener('scroll', handleScroll, { passive: true, signal });
        topBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // 2. 읽기 시간 계산
        if (prose && readingTimeText) {
          const text = prose.textContent || '';
          const minutes = Math.max(1, Math.ceil(text.trim().length / 500));
          readingTimeText.textContent = `약 ${minutes}분 읽기`;
        }

        // 3. 🖼️ 라이트박스 모달 풀 기능 구현
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalStage = document.getElementById('modal-stage');
        const closeBtn = document.getElementById('modal-close');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const thumbnailList = document.getElementById('thumbnail-list');

        const allImages = Array.from(
          prose?.querySelectorAll<HTMLImageElement>('img:not(.no-lightbox):not(.thumb-item)') || []
        ).filter((img) => img.src && img.src.trim() !== '');

        let currentIndex = 0;
        let isZoomed = false;
        let isDragging = false;
        let hasDragged = false;
        let startX = 0, startY = 0;
        let translateX = 0, translateY = 0;
        let currentX = 0, currentY = 0;
        let touchStartX = 0, touchStartY = 0;
        let touchEndX = 0, touchEndY = 0;
        let touchMoveStartX = 0, touchMoveStartY = 0;

        const resetZoom = () => {
          isZoomed = false;
          isDragging = false;
          hasDragged = false;
          translateX = 0;
          translateY = 0;
          currentX = 0;
          currentY = 0;
          if (modalImg) {
            modalImg.classList.remove('zoomed');
            modalImg.style.transform = 'translate(0px, 0px) scale(1)';
          }
        };

        const updateModalImage = (index: number) => {
          if (!allImages.length || !modalImg) return;
          resetZoom();
          currentIndex = (index + allImages.length) % allImages.length;
          const targetImg = allImages[currentIndex];
          modalImg.src = targetImg.currentSrc || targetImg.src;
          modalImg.alt = targetImg.alt || '확대 이미지';

          const thumbs = thumbnailList?.querySelectorAll('.thumb-item');
          thumbs?.forEach((thumb, i) => {
            if (i === currentIndex) {
              thumb.classList.add('active');
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
              thumb.classList.remove('active');
            }
          });
        };

        const buildThumbnails = () => {
          if (!thumbnailList) return;
          thumbnailList.innerHTML = '';

          allImages.forEach((img, i) => {
            const thumb = document.createElement('img');
            thumb.src = img.currentSrc || img.src;
            thumb.className = 'thumb-item';
            thumb.alt = `썸네일 ${i + 1}`;
            thumb.addEventListener('click', (e) => {
              e.stopPropagation();
              updateModalImage(i);
            });
            thumbnailList.appendChild(thumb);
          });
        };

        const openModal = (index: number) => {
          if (!modal) return;
          buildThumbnails();

          const isSingle = allImages.length <= 1;
          if (prevBtn) prevBtn.style.display = isSingle ? 'none' : 'flex';
          if (nextBtn) nextBtn.style.display = isSingle ? 'none' : 'flex';
          const thumbBar = modal.querySelector('.floating-thumbnail-bar') as HTMLElement | null;
          if (thumbBar) thumbBar.style.display = isSingle ? 'none' : 'flex';

          modal.classList.add('open');
          document.body.style.overflow = 'hidden';
          updateModalImage(index);

          if (window.location.hash !== '#modal-open') {
            history.pushState({ modalOpen: true }, '', '#modal-open');
          }
        };

        const closeModal = () => {
          if (modal && modal.classList.contains('open')) {
            resetZoom();
            modal.classList.remove('open');
            document.body.style.removeProperty('overflow');

            if (history.state?.modalOpen || window.location.hash === '#modal-open') {
              history.back();
            }
          }
        };

        // 스마트폰 뒤로 가기 감지
        const handlePopState = () => {
          if (modal && modal.classList.contains('open')) {
            resetZoom();
            modal.classList.remove('open');
            document.body.style.removeProperty('overflow');
          }
        };
        window.addEventListener('popstate', handlePopState, { signal });

        allImages.forEach((img, index) => {
          img.style.cursor = 'pointer';
          img.addEventListener('click', () => openModal(index));
        });

        // 줌 클릭 토글
        modalImg?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (hasDragged) {
            hasDragged = false;
            return;
          }

          isZoomed = !isZoomed;
          if (isZoomed && modalImg) {
            modalImg.classList.add('zoomed');
            modalImg.style.transform = 'translate(0px, 0px) scale(1.8)';
          } else {
            resetZoom();
          }
        });

        // 마우스 드래그 이동 (Pan)
        modalImg?.addEventListener('mousedown', (e) => {
          if (!isZoomed) return;
          e.preventDefault();
          isDragging = true;
          hasDragged = false;
          startX = e.clientX - currentX;
          startY = e.clientY - currentY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging || !isZoomed || !modalImg) return;
          e.preventDefault();

          if (Math.abs(e.clientX - (startX + currentX)) > 3 || Math.abs(e.clientY - (startY + currentY)) > 3) {
            hasDragged = true;
          }

          translateX = e.clientX - startX;
          translateY = e.clientY - startY;
          modalImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(1.8)`;
        }, { signal });

        const stopDragging = () => {
          if (isDragging) {
            isDragging = false;
            currentX = translateX;
            currentY = translateY;
          }
        };

        window.addEventListener('mouseup', stopDragging, { signal });
        window.addEventListener('mouseleave', stopDragging, { signal });

        // 터치 조작 (스와이프 및 드래그)
        modalStage?.addEventListener('touchstart', (e: TouchEvent) => {
          if (isZoomed) {
            touchMoveStartX = e.touches[0].clientX - currentX;
            touchMoveStartY = e.touches[0].clientY - currentY;
            return;
          }
          touchStartX = e.changedTouches[0].clientX;
          touchStartY = e.changedTouches[0].clientY;
        }, { passive: true });

        modalStage?.addEventListener('touchmove', (e: TouchEvent) => {
          if (!isZoomed || !modalImg) return;
          e.preventDefault();
          translateX = e.touches[0].clientX - touchMoveStartX;
          translateY = e.touches[0].clientY - touchMoveStartY;
          modalImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(1.8)`;
        }, { passive: false });

        modalStage?.addEventListener('touchend', (e: TouchEvent) => {
          if (isZoomed) {
            currentX = translateX;
            currentY = translateY;
            return;
          }
          touchEndX = e.changedTouches[0].clientX;
          touchEndY = e.changedTouches[0].clientY;

          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
          if (Math.abs(diffX) > Math.abs(diffY) * 1.5 && Math.abs(diffX) > 40) {
            if (diffX < 0) {
              updateModalImage(currentIndex + 1);
            } else {
              updateModalImage(currentIndex - 1);
            }
          }
        }, { passive: true });

        // 마우스 휠 사진 넘김 (확대 중엔 휠 넘김 방지)
        let wheelTimeout: NodeJS.Timeout | number | null = null;
        modalStage?.addEventListener('wheel', (e: WheelEvent) => {
          e.preventDefault();
          if (isZoomed) return;

          if (!wheelTimeout) {
            if (e.deltaY > 30) {
              updateModalImage(currentIndex + 1);
            } else if (e.deltaY < -30) {
              updateModalImage(currentIndex - 1);
            }
            wheelTimeout = setTimeout(() => {
              wheelTimeout = null;
            }, 250);
          }
        }, { passive: false });

        // 키보드 조작
        const handleKeyDown = (e: KeyboardEvent) => {
          if (!modal || !modal.classList.contains('open')) return;

          if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            resetZoom();
            updateModalImage(currentIndex - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            resetZoom();
            updateModalImage(currentIndex + 1);
          } else if (['ArrowUp', 'ArrowDown', ' '].includes(e.key)) {
            e.preventDefault();
          }
        };
        window.addEventListener('keydown', handleKeyDown, { signal });

        closeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          closeModal();
        });

        modal?.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('image-modal') || target.classList.contains('modal-stage')) {
            resetZoom();
            closeModal();
          }
        });

        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex - 1);
        });

        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex + 1);
        });

        // 4. 목차(TOC) 생성
        const tocContainer = document.getElementById('toc-container');
        const tocList = document.getElementById('toc-list');
        const toggleBtn = document.getElementById('toc-toggle-btn');
        let tocObserver: IntersectionObserver | null = null;

        if (prose && tocContainer && tocList) {
          const h2Elements = Array.from(prose.querySelectorAll('h2'));
          if (h2Elements.length > 0) {
            tocContainer.style.display = 'block';
            tocList.innerHTML = '';

            h2Elements.forEach((h2, idx) => {
              if (!h2.id) {
                const slug = h2.textContent?.trim().toLowerCase().replace(/[^\w\sㄱ-ㅎ가-힣-]/g, '').replace(/\s+/g, '-') || `heading-${idx}`;
                h2.id = slug;
              }
              const li = document.createElement('li');
              li.className = 'toc-item';
              const a = document.createElement('a');
              a.className = 'toc-link';
              a.href = `#${h2.id}`;
              a.textContent = h2.textContent || '';
              a.addEventListener('click', (e) => {
                e.preventDefault();
                const target = document.getElementById(h2.id);
                if (target) {
                  const offset = target.getBoundingClientRect().top + window.pageYOffset - 90;
                  window.scrollTo({ top: offset, behavior: 'smooth' });
                }
              });
              li.appendChild(a);
              tocList.appendChild(li);
            });

            tocObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const id = entry.target.id;
                  tocList.querySelectorAll('.toc-link').forEach((link) => {
                    link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
                  });
                }
              });
            }, { rootMargin: '-80px 0px -60% 0px' });

            h2Elements.forEach((h2) => tocObserver?.observe(h2));
          } else {
            tocContainer.style.display = 'none';
          }

          toggleBtn?.addEventListener('click', () => {
            tocContainer.classList.toggle('collapsed');
          });
        }

        currentCleanup = () => {
          abortController.abort();
          tocObserver?.disconnect();
          document.body.style.removeProperty('overflow');
        };
      }

      document.addEventListener('astro:page-load', initBlogPost);
      document.addEventListener('DOMContentLoaded', initBlogPost);
    </script>
  </body>
</html>