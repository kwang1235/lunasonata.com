---
// src/pages/index.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import '../styles/global.css';
import '../styles/home.css';

// 작성된 블로그 포스트 목록을 최신순으로 정렬
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="main-container">
			<!-- 프로필 히어로 영역 -->
			<section class="hero-card">
				<h1 class="hero-title">👋 세광의 기술 & 일상 기록</h1>
				<p class="hero-subtitle">시놀로지 NAS와 Astro로 직접 구축한 프라이빗 모던 블로그입니다.</p>
				<blockquote class="hero-quote">
					"생각하는 대로 살지 않으면, 사는 대로 생각하게 된다."
				</blockquote>
			</section>

			<!-- 최신 포스트 그리드 영역 -->
			<section>
				<div class="section-header">
					<h2 class="section-title">✨ 최신 포스트</h2>
				</div>

				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/${post.id}/`}>
									{post.data.heroImage && (
										typeof post.data.heroImage === 'string' ? (
											<img class="post-thumbnail" src={post.data.heroImage} alt={post.data.title} />
										) : (
											<Image class="post-thumbnail" src={post.data.heroImage} alt={post.data.title} width={720} height={360} />
										)
									)}
									<div class="post-info">
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>