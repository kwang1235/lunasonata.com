---
// src/components/InstagramCard.astro
interface Props {
  url: string;
  username: string;
  date: string;
  likes: string;
  caption: string;
}

const { url, username, date, likes, caption } = Astro.props;
const embedUrl = `${url.replace(/\/$/, '')}/embed`;
---

<div style="max-width: 470px; margin: 35px auto; border: 1px solid #dbdbdb; border-radius: 12px; background-color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06); overflow: hidden; box-sizing: border-box;">
  
  {/* 1. 상단 프로필 헤더 (우리가 생성한 깔끔한 헤더) */}
  <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #f0f0f0; background-color: #ffffff; position: relative; z-index: 2;">
    <a href={url} target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
      <div style="width: 38px; height: 38px; border-radius: 50%; background-color: #0095f6; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px;">
        S
      </div>
      <div style="display: flex; flex-direction: column;">
        <span style="font-size: 14px; font-weight: bold; color: #262626; line-height: 1.2;">{username}</span>
        <span style="font-size: 11px; color: #8e8e8e; margin-top: 2px;">Instagram</span>
      </div>
    </a>
    <a href={url} target="_blank" rel="noopener noreferrer" style="color: #0095f6; font-weight: 600; font-size: 13px; text-decoration: none; background-color: #efefef; padding: 6px 12px; border-radius: 8px;">
      팔로우
    </a>
  </div>

  {/* 2. 동영상 미디어 영역 (인스타 내부 상단 프로필을 -58px 끌어올려 잘라냄) */}
  <div style="position: relative; width: 100%; aspect-ratio: 4 / 5; background-color: #000000; overflow: hidden;">
    <iframe 
      src={embedUrl}
      style="position: absolute; top: -58px; left: 0; width: 100%; height: calc(100% + 58px); border: none; display: block;" 
      scrolling="no" 
      allowtransparency="true">
    </iframe>
  </div>

  {/* 3. 하단 좋아요 및 캡션 영역 */}
  <div style="padding: 12px 14px; background-color: #ffffff; position: relative; z-index: 2;">
    <div style="font-size: 14px; color: #262626; margin-bottom: 6px; text-align: left; font-weight: bold;">
      좋아요 {likes}
    </div>

    <div style="font-size: 14px; color: #262626; line-height: 1.45; margin-bottom: 8px; word-break: break-word; text-align: left;">
      <strong style="margin-right: 6px;">{username}</strong>
      {date}<br/><br/>
      {caption}
    </div>

    <a href={url} target="_blank" rel="noopener noreferrer" style="display: inline-block; font-size: 12px; color: #8e8e8e; text-decoration: none; font-weight: 500;">
      Instagram 앱에서 보기 ↗
    </a>
  </div>
</div>